# Install as /etc/indiefi/web.env with mode 0640. The final service user and
# group ownership are created with the systemd units in stage 13-0-4-5.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
AllowedHosts=

ConnectionStrings__Database=
ReverseProxy__KnownProxies__0=127.0.0.1

Authentication__Google__Enabled=false

WaitingRoom__Redis__Enabled=true
WaitingRoom__Redis__ConnectionString=

Messaging__RabbitMq__Enabled=true
Messaging__RabbitMq__Host=127.0.0.1
Messaging__RabbitMq__Port=5672
Messaging__RabbitMq__VirtualHost=/
Messaging__RabbitMq__Username=indiefi
Messaging__RabbitMq__Password=
Messaging__RabbitMq__EndpointPrefix=indiefi

Media__ObjectStorage__Enabled=true
Media__ObjectStorage__ServiceUrl=
Media__ObjectStorage__Region=auto
Media__ObjectStorage__BucketName=indiefi-media-portfolio
Media__ObjectStorage__AccessKeyId=
Media__ObjectStorage__SecretAccessKey=
Media__ObjectStorage__ForcePathStyle=false
Media__Worker__Enabled=false

AccountProtectionKeyFile__Path=/etc/indiefi/keys/account-protection.json
DataProtectionKeyManagement__CertificatePath=/etc/indiefi/keys/data-protection.crt
DataProtectionKeyManagement__PrivateKeyPath=/etc/indiefi/keys/data-protection.key
