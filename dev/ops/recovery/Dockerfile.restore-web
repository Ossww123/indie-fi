FROM node:22-bookworm-slim AS client
WORKDIR /src
COPY src/IndieFi.Web/package.json src/IndieFi.Web/package-lock.json ./
RUN npm ci
COPY src/IndieFi.Web/ ./
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/IndieFi.Web/IndieFi.Web.csproj src/IndieFi.Web/
RUN dotnet restore src/IndieFi.Web/IndieFi.Web.csproj
COPY src/IndieFi.Web/ src/IndieFi.Web/
COPY --from=client /src/wwwroot/js/dist/ src/IndieFi.Web/wwwroot/js/dist/
COPY --from=client /src/wwwroot/css/dist/ src/IndieFi.Web/wwwroot/css/dist/
RUN dotnet publish src/IndieFi.Web/IndieFi.Web.csproj \
    --configuration Release \
    --output /app/publish \
    --no-restore \
    -p:ClientBuildEnabled=false \
    -p:ClientAssetsPrepared=true \
    -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish/ ./
USER $APP_UID
ENTRYPOINT ["dotnet", "IndieFi.Web.dll"]
