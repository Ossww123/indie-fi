# Install temporarily as /etc/indiefi/database-bootstrap.env with owner root:root
# and mode 0600. Generate the value with `openssl rand -base64 32`.
#
# This password becomes the indiefi_app login used by both web.env and worker.env.
# Delete this bootstrap file only after both runtime files contain the same application
# connection string and the first Web/Worker deployment succeeds.

APPLICATION_DATABASE_PASSWORD=
