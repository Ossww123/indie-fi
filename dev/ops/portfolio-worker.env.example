# Install as /etc/indiefi/worker.env with owner root:indiefi-worker and mode 0640.
# This process owns all SMTP delivery and media work; it has no listening address.

DOTNET_ENVIRONMENT=Production

ConnectionStrings__Database=

Observability__Enabled=false
Observability__OtlpEndpoint=http://127.0.0.1:4317
Observability__TraceSamplingRatio=0.1
Observability__ServiceVersion=
Observability__InstanceId=worker-1

WaitingRoom__Redis__Enabled=true
WaitingRoom__Redis__ConnectionString=

Messaging__RabbitMq__Enabled=true
Messaging__RabbitMq__Host=127.0.0.1
Messaging__RabbitMq__Port=5672
Messaging__RabbitMq__VirtualHost=/
Messaging__RabbitMq__Username=indiefi
Messaging__RabbitMq__Password=
Messaging__RabbitMq__EndpointPrefix=indiefi

Media__ObjectStorage__Enabled=true
Media__ObjectStorage__ServiceUrl=
Media__ObjectStorage__Region=auto
Media__ObjectStorage__BucketName=indiefi-media-portfolio
Media__ObjectStorage__AccessKeyId=
Media__ObjectStorage__SecretAccessKey=
Media__ObjectStorage__ForcePathStyle=false
Media__Worker__Enabled=true

AccountProtectionKeyFile__Path=/etc/indiefi/keys/account-protection.json

AuthenticationEmail__Enabled=true
AuthenticationEmail__PublicBaseUrl=
AuthenticationEmail__Smtp__Host=email-smtp.ap-northeast-2.amazonaws.com
AuthenticationEmail__Smtp__Port=587
AuthenticationEmail__Smtp__EnableSsl=true
AuthenticationEmail__Smtp__Username=
AuthenticationEmail__Smtp__Password=
AuthenticationEmail__Smtp__FromAddress=
AuthenticationEmail__Smtp__FromName=IndieFi

NotificationEmail__Enabled=true
NotificationEmail__PublicBaseUrl=
NotificationEmail__Smtp__Host=email-smtp.ap-northeast-2.amazonaws.com
NotificationEmail__Smtp__Port=587
NotificationEmail__Smtp__EnableSsl=true
NotificationEmail__Smtp__Username=
NotificationEmail__Smtp__Password=
NotificationEmail__Smtp__FromAddress=
NotificationEmail__Smtp__FromName=IndieFi

NotificationMaintenance__Enabled=true
NotificationOperations__Enabled=true
