# Install as /etc/indiefi/infra.env with mode 0600. Generate a different random
# value for every entry; never copy a Web or Worker application password here.
# The one-time application role password belongs in database-bootstrap.env instead.
#
# Example generator (run once for each value):
#   openssl rand -base64 32

POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
