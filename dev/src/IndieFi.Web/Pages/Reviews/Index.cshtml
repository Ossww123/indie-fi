@page
@model IndexModel
@{
    ViewData["Title"] = "리뷰 작업";
    ViewData["MainClass"] = "site-main-queue";
    var completedCount = Model.AssignmentHistory.Count(item => item.IsCompleted);
    var expiredCount = Model.AssignmentHistory.Count - completedCount;
}

<header class="ivory-page-heading">
    <div>
        <h1>리뷰 작업</h1>
        <p>작업은 한 번에 하나씩 배정됩니다. 마감 전에 플레이 경험을 구체적인 피드백으로 남겨 주세요.</p>
    </div>
    <a asp-page="/Credits/Index" class="ivory-credit-chip">
        <span aria-hidden="true"></span>
        내 크레딧 보기
    </a>
</header>

@if (Model.ClaimMessage is { } claimMessage)
{
    <div class="@(claimMessage.IsSuccess ? "alert-success" : "alert-warning")" role="status">@claimMessage.Message</div>
}
@if (Model.SubmitMessage is { } submitMessage)
{
    <div class="@(submitMessage.IsSuccess ? "alert-success" : "alert-warning")" role="status">@submitMessage.Message</div>
}
@if (Model.SweepMessage is { } sweepMessage)
{
    <div class="@(sweepMessage.IsSuccess ? "alert-success" : "alert-neutral")" role="status">@sweepMessage.Message</div>
}

<div class="ivory-queue-tabs" aria-label="리뷰 작업 상태 요약">
    <span class="ivory-queue-tab-active">ACTIVE · @Model.MyAssignments.Count</span>
    <span>SUBMITTED · @completedCount</span>
    <span>EXPIRED · @expiredCount</span>
</div>

<section aria-labelledby="active-assignments-heading">
    <h2 id="active-assignments-heading" class="sr-only">내가 받은 작업</h2>
    @if (Model.MyAssignments.Count == 0)
    {
        <div class="empty-state empty-state-compact" data-empty-state="active-review-assignments">
            <div class="empty-state-icon" aria-hidden="true">◇</div>
            <h3 class="empty-state-title">진행 중인 리뷰 작업이 없습니다.</h3>
            <p class="empty-state-description">아래에서 새 리뷰 작업을 배정받을 수 있습니다.</p>
        </div>
    }
    else
    {
        <div class="ivory-queue-table">
            <div class="ivory-queue-table-head" aria-hidden="true">
                <span>GAME</span><span>DEADLINE</span><span>STATUS</span><span></span>
            </div>
            @foreach (var assignment in Model.MyAssignments)
            {
                var isOverdue = assignment.LeasedUntil <= DateTimeOffset.UtcNow;
                <article class="ivory-queue-row">
                    <div class="ivory-queue-game">
                        <span class="ivory-queue-cover" aria-hidden="true"></span>
                        <span>
                            <strong>@assignment.GameTitle</strong>
                            <small>배정 @assignment.AssignedAt.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</small>
                        </span>
                    </div>
                    <time class="@(isOverdue ? "ivory-time-urgent" : null)"
                          datetime="@assignment.LeasedUntil.ToString("O")">
                        @assignment.LeasedUntil.ToLocalTime().ToString("MM.dd HH:mm")
                    </time>
                    <span class="@(isOverdue ? "badge-warning" : "badge-success")">
                        @(isOverdue ? "마감 지남" : "진행 중")
                    </span>
                    @if (!isOverdue)
                    {
                        <a asp-page="Submit"
                           asp-route-assignmentId="@assignment.AssignmentId"
                           class="button-primary button-small">피드백 쓰기</a>
                    }
                    else
                    {
                        <span class="text-meta">정리 필요</span>
                    }
                </article>
            }
        </div>
    }
</section>

<div class="ivory-queue-actions">
    <section class="ivory-queue-action-primary" aria-labelledby="review-claim-heading">
        <h2 id="review-claim-heading">새 리뷰를 시작할까요?</h2>
        <p>대기 중인 요청에서 현재 조건에 맞는 작업 하나를 배정받습니다.</p>
        <form method="post" asp-page-handler="Claim">
            <input type="hidden" name="operationId" value="@Model.ClaimOperationId" />
            <button type="submit" class="button-primary">리뷰 작업 받기</button>
        </form>
    </section>
    <section class="ivory-queue-action-secondary">
        <h2>마감된 작업 정리</h2>
        <p>기한이 지난 배정을 반환해 다른 리뷰어가 작업을 받을 수 있게 합니다.</p>
        <form method="post" asp-page-handler="Sweep">
            <button type="submit" class="button-outline">마감 지난 작업 정리</button>
        </form>
    </section>
</div>

<section class="ivory-queue-section" aria-labelledby="review-history-heading">
    <div class="ivory-section-heading">
        <h2 id="review-history-heading">내 작업 이력</h2>
        <span>@Model.AssignmentHistory.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)개</span>
    </div>
    @if (Model.AssignmentHistory.Count == 0)
    {
        <div class="empty-state empty-state-compact" data-empty-state="review-history">
            <div class="empty-state-icon" aria-hidden="true">◇</div>
            <h3 class="empty-state-title">완료하거나 만료된 작업이 없습니다.</h3>
            <p class="empty-state-description">작업을 제출하거나 마감이 지나면 이력에서 상태를 확인할 수 있습니다.</p>
        </div>
    }
    else
    {
        <div class="ivory-history-list">
            @foreach (var assignment in Model.AssignmentHistory)
            {
                <div class="ivory-history-row">
                    <strong>@assignment.GameTitle</strong>
                    <time datetime="@assignment.AssignedAt.ToString("O")">@assignment.AssignedAt.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</time>
                    <time datetime="@assignment.EndedAt.ToString("O")">@assignment.EndedAt.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</time>
                    <span class="@(assignment.IsCompleted ? "badge-success" : "badge-neutral")">@assignment.StatusText</span>
                </div>
            }
        </div>
    }
</section>

<section class="ivory-queue-section" aria-labelledby="review-queue-heading">
    <div class="ivory-section-heading">
        <h2 id="review-queue-heading">피드백을 기다리는 게임</h2>
        <span>@Model.Items.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)개</span>
    </div>
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state empty-state-compact" data-empty-state="review-queue">
            <div class="empty-state-icon" aria-hidden="true">◇</div>
            <h3 class="empty-state-title">지금은 기다리는 요청이 없습니다.</h3>
            <p class="empty-state-description">새 피드백 요청이 등록되면 작업 받기 대상에 포함됩니다.</p>
        </div>
    }
    else
    {
        <div class="ivory-waiting-grid">
            @foreach (var item in Model.Items)
            {
                <article class="ivory-waiting-card">
                    <span class="ivory-waiting-cover" aria-hidden="true">COVER</span>
                    <div>
                        <h3>@item.GameTitle</h3>
                        <p>
                            by <a asp-page="/Profiles/Detail" asp-route-id="@item.RequesterId">@item.RequesterDisplayName</a>
                        </p>
                        <time datetime="@item.RequestedAt.ToString("O")">@item.RequestedAt.ToLocalTime().ToString("yyyy.MM.dd HH:mm") 요청</time>
                    </div>
                </article>
            }
        </div>
    }
</section>
