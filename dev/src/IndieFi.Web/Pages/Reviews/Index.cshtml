@page
@model IndexModel
@{
    ViewData["Title"] = "리뷰 작업";
}

<h1 class="h3 mb-4">피드백을 기다리는 게임 @(Model.Items.Count)개</h1>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-secondary">지금은 기다리는 요청이 없습니다.</div>
}
else
{
    <div class="list-group">
        @foreach (var item in Model.Items)
        {
            <div class="list-group-item">
                <div class="fw-bold">@item.GameTitle</div>
                <div class="text-muted">
                    @item.RequesterEmail · @item.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </div>
            </div>
        }
    </div>
}
