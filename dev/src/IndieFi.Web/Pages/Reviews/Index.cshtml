@page
@model IndexModel
@{
    ViewData["Title"] = "리뷰 작업";
}

<h1 class="page-title mb-6">리뷰 작업</h1>

@if (Model.ClaimMessage is { } claimMessage)
{
    <div class="@(claimMessage.IsSuccess ? "alert-success" : "alert-warning")" role="status">
        @claimMessage.Message
    </div>
}

@if (Model.SubmitMessage is { } submitMessage)
{
    <div class="@(submitMessage.IsSuccess ? "alert-success" : "alert-warning")" role="status">
        @submitMessage.Message
    </div>
}

@if (Model.SweepMessage is { } sweepMessage)
{
    <div class="@(sweepMessage.IsSuccess ? "alert-success" : "alert-neutral")" role="status">
        @sweepMessage.Message
    </div>
}

@if (Model.MyAssignments.Count > 0)
{
    <section class="mb-8">
        <h2 class="section-title">내가 받은 작업 @(Model.MyAssignments.Count)개</h2>
        <div class="surface-list">
            @foreach (var assignment in Model.MyAssignments)
            {
                <div class="surface-item">
                    <div class="font-semibold">@assignment.GameTitle</div>
                    <div class="text-meta">
                        배정 @assignment.AssignedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        · 마감 @assignment.LeasedUntil.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </div>
                    @if (assignment.LeasedUntil <= DateTimeOffset.UtcNow)
                    {
                        <div class="mt-2 text-sm font-medium text-amber-700">마감 지남</div>
                    }
                    else
                    {
                        <div>
                            <a asp-page="Submit"
                               asp-route-assignmentId="@assignment.AssignmentId"
                               class="text-link mt-2 inline-block">피드백 쓰기</a>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

<section class="mb-8">
    <h2 class="section-title">내 작업 이력 @(Model.AssignmentHistory.Count)개</h2>
    @if (Model.AssignmentHistory.Count == 0)
    {
        <div class="alert-neutral">완료하거나 만료된 작업이 없습니다.</div>
    }
    else
    {
        <div class="surface-list">
            @foreach (var assignment in Model.AssignmentHistory)
            {
                <div class="surface-item">
                    <div class="flex items-center justify-between gap-4">
                        <div class="font-semibold">@assignment.GameTitle</div>
                        <span class="@(assignment.IsCompleted ? "badge-success" : "badge-neutral")">
                            @assignment.StatusText
                        </span>
                    </div>
                    <div class="text-meta mt-1">
                        배정 @assignment.AssignedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        · @assignment.StatusText @assignment.EndedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </div>
                </div>
            }
        </div>
    }
</section>

<div class="button-group mb-8">
    <form method="post" asp-page-handler="Claim">
        <input type="hidden" name="operationId" value="@Model.ClaimOperationId" />
        <button type="submit" class="button-primary">리뷰 작업 받기</button>
    </form>

    <form method="post" asp-page-handler="Sweep">
        <button type="submit" class="button-secondary">마감 지난 작업 정리</button>
    </form>
</div>

<section>
    <h2 class="section-title">피드백을 기다리는 게임 @(Model.Items.Count)개</h2>

    @if (Model.Items.Count == 0)
    {
        <div class="alert-neutral">지금은 기다리는 요청이 없습니다.</div>
    }
    else
    {
        <div class="surface-list">
            @foreach (var item in Model.Items)
            {
                <div class="surface-item">
                    <div class="font-semibold">@item.GameTitle</div>
                    <div class="text-meta">
                        <a asp-page="/Profiles/Detail"
                           asp-route-id="@item.RequesterId"
                           class="text-link">@item.RequesterDisplayName</a>
                        · @item.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </div>
                </div>
            }
        </div>
    }
</section>
