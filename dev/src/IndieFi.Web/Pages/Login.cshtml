@page
@model LoginModel
@{
    ViewData["Title"] = "로그인";
}

<h1 class="page-title mb-6">로그인</h1>

<form method="post" class="form-stack">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="field-group">
        <label asp-for="Email" class="field-label">이메일</label>
        <input asp-for="Email" class="field-input" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div class="field-group">
        <label asp-for="Password" class="field-label">비밀번호</label>
        <input asp-for="Password" class="field-input" autocomplete="current-password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <button type="submit" class="button-primary">로그인</button>
</form>

<a asp-page="/ResendConfirmationEmail" class="button-link mt-4">
    확인 메일 다시 받기
</a>
