@page
@model SignupModel
@{
    ViewData["Title"] = "가입";
}

<h1 class="page-title mb-6">가입</h1>

<form method="post" class="form-stack">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="field-group">
        <label asp-for="Email" class="field-label">이메일</label>
        <input asp-for="Email" class="field-input" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div class="field-group">
        <label asp-for="Password" class="field-label">비밀번호</label>
        <input asp-for="Password" class="field-input" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <button type="submit" class="button-primary">가입하기</button>
</form>
