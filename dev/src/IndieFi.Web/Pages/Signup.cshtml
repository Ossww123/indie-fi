@page
@model SignupModel
@{
    ViewData["Title"] = "가입";
}

<h1 class="h3 mb-4">가입</h1>

<form method="post" class="col-md-5">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">이메일</label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">비밀번호</label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary">가입하기</button>
</form>
