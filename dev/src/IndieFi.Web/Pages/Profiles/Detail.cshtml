@page "/Profiles/{id:long}"
@model DetailModel
@{
    ViewData["Title"] = Model.Profile.DisplayName;
}

@if (Model.FollowMessage is not null)
{
    <div class="alert-success mb-6" role="status">@Model.FollowMessage</div>
}

<div class="flex flex-col gap-5 sm:flex-row sm:items-center">
    @if (Model.ProfileImage is { } profileImage)
    {
        <img data-profile-image
             data-media-id="@profileImage.MediaId"
             src="@profileImage.Url"
             alt="@Model.Profile.DisplayName 프로필 이미지"
             class="size-24 shrink-0 rounded-full bg-slate-100 object-cover"
             width="96"
             height="96"
             referrerpolicy="no-referrer" />
    }
    else
    {
        <div class="flex size-24 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-indigo-700"
             data-default-profile-image>
            <svg class="size-12"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.5"
                 role="img"
                 aria-label="기본 프로필 이미지">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.12a7.5 7.5 0 0 1 15 0A17.9 17.9 0 0 1 12 21.75a17.9 17.9 0 0 1-7.5-1.63Z" />
            </svg>
        </div>
    }
    <div>
        <div class="flex flex-wrap items-center gap-3">
            <h1 class="page-title">@Model.Profile.DisplayName</h1>
            @if (Model.IsOwner)
            {
                <a asp-page="/Account/Profile" class="button-outline px-3 py-1.5">프로필 수정</a>
                <a asp-page="/Account/Following" class="button-outline px-3 py-1.5">팔로잉 목록</a>
            }
            else if (Model.CanManageFollow)
            {
                @if (Model.IsFollowing)
                {
                    <form method="post"
                          asp-page-handler="Unfollow"
                          asp-route-id="@Model.Profile.UserId">
                        <button type="submit" class="button-outline px-3 py-1.5">팔로우 해제</button>
                    </form>
                }
                else
                {
                    <form method="post"
                          asp-page-handler="Follow"
                          asp-route-id="@Model.Profile.UserId">
                        <button type="submit" class="button-primary px-3 py-1.5">팔로우</button>
                    </form>
                }
            }
            else
            {
                <a asp-page="/Login"
                   asp-route-returnUrl="@($"/Profiles/{Model.Profile.UserId}")"
                   class="button-outline px-3 py-1.5">로그인 후 팔로우</a>
            }
        </div>
        @if (string.IsNullOrEmpty(Model.Profile.Biography))
        {
            <p class="mt-3 text-slate-500">아직 소개가 없습니다.</p>
        }
        else
        {
            <p class="mt-3 max-w-3xl whitespace-pre-line leading-7 text-slate-700">@Model.Profile.Biography</p>
        }
    </div>
</div>

<h2 class="subsection-title mt-10">리뷰 활동</h2>
<div class="surface-item mt-3">
    <span class="font-semibold">완료한 리뷰</span>
    <span class="ml-2 text-slate-600">@(Model.Profile.CompletedReviewCount)개</span>
</div>

<h2 class="subsection-title mt-10">등록한 게임</h2>
@if (Model.Profile.Games.Count == 0)
{
    <div class="alert-neutral">아직 등록한 게임이 없습니다.</div>
}
else
{
    <div class="surface-list">
        @foreach (var game in Model.Profile.Games)
        {
            <a asp-page="/Games/Detail"
               asp-route-id="@game.Id"
               class="surface-item surface-link">
                <div class="flex items-center justify-between gap-4">
                    <span class="font-semibold">@game.Title</span>
                    <span class="text-meta">@game.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                </div>
                @if (game.Description is not null)
                {
                    <div>@game.Description</div>
                }
                else
                {
                    <div class="text-slate-500">(소개 없음)</div>
                }
            </a>
        }
    </div>
}
