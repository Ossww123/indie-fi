@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "비밀번호 찾기";
    ViewData["MainClass"] = "site-main-auth";
}

<section class="auth-shell ivory-auth-shell" data-auth-page="forgot-password">
    <div class="ivory-auth-panel">
        <nav class="ivory-auth-tabs" aria-label="인증 메뉴">
            <a asp-page="/Login">SIGN IN</a>
            <a asp-page="/Signup">SIGN UP</a>
            <span aria-current="page">RESET</span>
        </nav>

        <header class="auth-header">
            <div class="ivory-auth-state-icon" aria-hidden="true">✉</div>
            <p class="auth-eyebrow ivory-auth-eyebrow-spaced">ACCOUNT RECOVERY</p>
            <h1 class="auth-title">비밀번호 찾기</h1>
            <p class="auth-description">가입한 이메일을 입력하면 비밀번호 재설정 절차를 안내합니다.</p>
        </header>

        <div class="auth-card">
            @if (Model.RequestCompleted)
            {
                <div class="alert-success ivory-auth-request-result" role="status">
                    입력한 이메일에 재설정 가능한 계정이 있고 요청 제한 범위 안이면 비밀번호 재설정 메일을 보냈습니다.
                </div>
            }

            <form method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" role="alert"></div>
                <div class="field-group">
                    <label asp-for="Email" class="field-label">이메일</label>
                    <input asp-for="Email" class="field-input" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <button type="submit" class="button-primary w-full">재설정 메일 받기</button>
            </form>

            <div class="ivory-auth-privacy">
                <span aria-hidden="true">i</span>
                <p>보안을 위해 입력한 이메일의 가입 여부는 따로 알려드리지 않습니다. 받은편지함과 스팸함을 확인해 주세요.</p>
            </div>

            <nav class="auth-links" aria-label="비밀번호 찾기 도움말">
                <a asp-page="/Login" class="text-link">로그인으로 돌아가기</a>
            </nav>
        </div>
    </div>

    <aside class="ivory-auth-visual ivory-auth-visual-reset" aria-label="계정 복구 안내">
        <div class="ivory-auth-mark" aria-hidden="true">↺</div>
        <div class="ivory-auth-visual-copy">
            <p>ACCOUNT RECOVERY</p>
            <h2>메일에서 시작해<br />안전하게 복구합니다.</h2>
        </div>
    </aside>
</section>
