@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "비밀번호 찾기";
}

<section class="auth-shell" data-auth-page="forgot-password">
    <header class="auth-header">
        <p class="auth-eyebrow">ACCOUNT HELP</p>
        <h1 class="auth-title">비밀번호 찾기</h1>
        <p class="auth-description">가입한 이메일을 입력하면 비밀번호 재설정 절차를 안내합니다.</p>
    </header>

    <div class="auth-card">
        @if (Model.RequestCompleted)
        {
            <div class="alert-success" role="status">
                입력한 이메일에 재설정 가능한 계정이 있고 요청 제한 범위 안이면 비밀번호 재설정 메일을 보냈습니다.
            </div>
        }

        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="field-group">
                <label asp-for="Email" class="field-label">이메일</label>
                <input asp-for="Email" class="field-input" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <button type="submit" class="button-primary w-full">재설정 메일 받기</button>
        </form>

        <nav class="auth-links" aria-label="비밀번호 찾기 도움말">
            <a asp-page="/Login" class="text-link">로그인으로 돌아가기</a>
        </nav>
    </div>
</section>
