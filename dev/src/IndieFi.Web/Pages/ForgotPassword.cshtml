@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "비밀번호 찾기";
}

<h1 class="page-title mb-6">비밀번호 찾기</h1>

@if (Model.RequestCompleted)
{
    <div class="alert-success mb-6">
        입력한 이메일에 재설정 가능한 계정이 있고 요청 제한 범위 안이면 비밀번호 재설정 메일을 보냈습니다.
    </div>
}

<form method="post" class="form-stack">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="field-group">
        <label asp-for="Email" class="field-label">이메일</label>
        <input asp-for="Email" class="field-input" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <button type="submit" class="button-primary">재설정 메일 받기</button>
</form>

<a asp-page="/Login" class="button-link mt-4">
    로그인으로 돌아가기
</a>
