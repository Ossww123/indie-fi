@inject IndieFi.Web.Application.Abstractions.ICurrentUser CurrentUser
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Indie-Fi</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/dist/site.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen flex-col">
    <header class="border-b border-slate-200 bg-white shadow-sm">
        <nav class="site-container" aria-label="주 메뉴">
            <div class="flex min-h-16 flex-wrap items-center justify-between py-3 sm:flex-nowrap sm:py-0">
                <a class="text-xl font-bold tracking-tight text-slate-950" asp-area="" asp-page="/Index">Indie-Fi</a>
                <button type="button"
                        class="inline-flex items-center justify-center rounded-lg border border-slate-300 p-2 text-slate-700 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 sm:hidden"
                        data-navigation-toggle
                        aria-controls="site-navigation"
                        aria-expanded="false">
                    <span class="sr-only" data-navigation-label>메뉴 열기</span>
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <div id="site-navigation"
                     class="hidden w-full flex-col gap-1 border-t border-slate-200 pt-3 sm:flex sm:w-auto sm:flex-row sm:items-center sm:border-0 sm:pt-0"
                     data-navigation-menu>
                    <a class="site-nav-link" asp-area="" asp-page="/Index">홈</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="site-nav-link" asp-area="" asp-page="/Games/Index">내 게임</a>
                        <a class="site-nav-link" asp-area="" asp-page="/Games/New">게임 등록</a>
                        <a class="site-nav-link" asp-area="" asp-page="/Credits/Index">내 크레딧</a>
                        <a class="site-nav-link" asp-area="" asp-page="/Reviews/Index">리뷰 작업</a>
                        <a class="site-nav-link" asp-area="" asp-page="/Account/Profile">내 프로필</a>
                        <a class="site-nav-link" asp-area="" asp-page="/Account/Password">비밀번호 변경</a>
                        @if (CurrentUser.UserId is long currentUserId)
                        {
                            <a asp-page="/Profiles/Detail"
                               asp-route-id="@currentUserId"
                               class="site-nav-link">@User.Identity.Name 님</a>
                        }
                        <form method="post" asp-page="/Logout">
                            <button type="submit" class="site-nav-link w-full text-left">로그아웃</button>
                        </form>
                    }
                    else
                    {
                        <a class="site-nav-link" asp-area="" asp-page="/Login">로그인</a>
                        <a class="site-nav-link" asp-area="" asp-page="/Signup">가입</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="site-container flex-1 py-8 sm:py-10">
        @RenderBody()
    </main>

    <footer class="border-t border-slate-200 bg-white py-5 text-sm text-slate-500">
        <div class="site-container flex flex-col justify-between gap-2 sm:flex-row">
            <span>&copy; 2026 - Indie-Fi</span>
            <span>build @BuildInfo.Revision</span>
        </div>
    </footer>

    <script type="module" src="~/js/dist/layout/navigation.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
