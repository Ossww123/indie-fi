@page
@using IndieFi.Web.Entities
@model IndexModel
@{
    ViewData["Title"] = "내 크레딧";
}

<h1 class="h3 mb-4">내 크레딧</h1>

<div class="display-6 mb-4">현재 @Model.Balance 크레딧</div>

@if (Model.Entries.Count == 0)
{
    <div class="alert alert-secondary">크레딧 내역이 없습니다.</div>
}
else
{
    <div class="list-group">
        @foreach (var entry in Model.Entries)
        {
            var deltaClass = entry.Delta > 0
                ? "text-success"
                : entry.Delta < 0
                    ? "text-danger"
                    : "text-muted";
            var description = entry.Kind switch
            {
                CreditEntryKind.Grant => "가입 축하 지급",
                _ => entry.Kind.ToString(),
            };

            <div class="list-group-item">
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted">@entry.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                    <span class="fw-bold @deltaClass">@entry.Delta.ToString("+0;-0;0")</span>
                    <span>@description</span>
                </div>
            </div>
        }
    </div>
}
