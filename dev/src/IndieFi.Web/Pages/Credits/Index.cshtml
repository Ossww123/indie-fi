@page
@using IndieFi.Web.Modules.Credits.Domain
@model IndexModel
@{
    ViewData["Title"] = "내 크레딧";
}

<h1 class="page-title mb-6">내 크레딧</h1>

<div class="surface-highlight mb-6 text-2xl font-semibold">
    현재 @Model.Balance 크레딧
</div>

@if (Model.Entries.Count == 0)
{
    <div class="alert-neutral">크레딧 내역이 없습니다.</div>
}
else
{
    <div class="surface-list">
        @foreach (var entry in Model.Entries)
        {
            var deltaClass = entry.Delta > 0
                ? "text-emerald-700"
                : entry.Delta < 0
                    ? "text-red-700"
                    : "text-slate-500";
            var description = entry.Kind switch
            {
                CreditEntryKind.Grant => "가입 축하 지급",
                _ => entry.Kind.ToString(),
            };

            <div class="surface-item">
                <div class="flex flex-wrap items-center gap-3">
                    <span class="text-meta">@entry.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                    <span class="font-semibold @deltaClass">@entry.Delta.ToString("+0;-0;0")</span>
                    <span>@description</span>
                </div>
            </div>
        }
    </div>
}
