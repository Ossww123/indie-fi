@page
@using IndieFi.Web.Modules.Credits.Domain
@model IndexModel
@{
    ViewData["Title"] = "내 크레딧";
}

<header class="page-heading">
    <div class="page-heading-copy">
        <h1 class="page-title">내 크레딧</h1>
        <p class="page-description">리뷰 활동으로 적립하거나 피드백 요청에 사용한 크레딧 내역입니다.</p>
    </div>
</header>

<partial name="_AccountTools" />

<div class="account-balance">
    <div>
        <span class="text-sm font-semibold text-white/65">사용 가능한 잔액</span>
        <strong class="account-balance-value mt-1 block">현재 @Model.Balance 크레딧</strong>
    </div>
    <span class="text-sm text-white/65">내역은 최신순으로 표시됩니다.</span>
</div>

@if (Model.Entries.Count == 0)
{
    <div class="empty-state" data-empty-state="credits">
        <div class="empty-state-icon" aria-hidden="true">◇</div>
        <h2 class="empty-state-title">크레딧 내역이 없습니다.</h2>
        <p class="empty-state-description">리뷰를 완료하거나 피드백 요청에 크레딧을 사용하면 내역이 여기에 기록됩니다.</p>
        <div class="empty-state-actions">
            <a asp-page="/Reviews/Index" class="button-primary">리뷰 작업 보기</a>
        </div>
    </div>
}
else
{
    <div class="surface-list">
        @foreach (var entry in Model.Entries)
        {
            var deltaClass = entry.Delta > 0
                ? "text-state-success-text"
                : entry.Delta < 0
                    ? "text-state-danger-text"
                    : "text-brand-ink/55";
            var description = entry.Kind switch
            {
                CreditEntryKind.Grant => "가입 축하 지급",
                _ => entry.Kind.ToString(),
            };

            <div class="surface-item">
                <div class="flex flex-wrap items-center gap-3">
                    <span class="text-meta">@entry.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                    <span>@description</span>
                    <strong class="ml-auto text-lg @deltaClass">@entry.Delta.ToString("+0;-0;0")</strong>
                </div>
            </div>
        }
    </div>
}
