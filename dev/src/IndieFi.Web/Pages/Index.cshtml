@page
@model IndexModel
@{
    ViewData["Title"] = "홈";
}

@if (TempData["SignupMessage"] is string signupMessage)
{
    <div class="alert-success" role="status">@signupMessage</div>
}

<section class="home-hero" data-home-hero>
    <div class="home-hero-copy">
        <p class="home-eyebrow">PLAY · REVIEW · GROW</p>
        <h1 class="home-title">새로운 게임을 만나고<br class="hidden sm:block" /> 좋은 경험을 나눠보세요.</h1>
        <p class="home-description">
            인디 게임을 먼저 플레이하고, 창작자에게 도움이 되는 피드백을 남기는 공간입니다.
        </p>
        <div class="button-group mt-6">
            <a href="#game-discovery-results" class="button-secondary button-large">게임 둘러보기</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Games/New" class="button-link button-large">내 게임 소개하기</a>
            }
            else
            {
                <a asp-page="/Signup" class="button-link button-large">무료로 시작하기</a>
            }
        </div>
    </div>

    <form method="get" data-discovery-filter class="home-search-panel">
        <div>
            <p class="home-search-kicker">게임 탐색</p>
            <h2 id="discovery-filter-title" class="home-search-title">어떤 게임을 찾고 있나요?</h2>
        </div>
        <div class="home-search-row">
            <label for="discovery-query" class="sr-only">제목·소개 검색</label>
            <input id="discovery-query"
                   class="field-input home-search-input"
                   type="search"
                   name="q"
                   value="@Model.Query"
                   minlength="2"
                   maxlength="100"
                   placeholder="게임 제목이나 소개 검색" />
            <button type="submit" class="button-primary button-large">검색</button>
        </div>

        <details class="discovery-filter-details"
                 open="@((Model.HasAdvancedFilters || Model.Violations.Count > 0) ? "open" : null)"
                 data-discovery-advanced>
            <summary class="discovery-filter-summary">
                <span>
                    <strong>상세 필터</strong>
                    <span class="text-meta ml-2">장르·태그·플랫폼·등록일</span>
                </span>
                <svg class="discovery-filter-chevron size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5.2 7.2a.75.75 0 0 1 1.1 0L10 10.9l3.7-3.7a.75.75 0 1 1 1.1 1.1l-4.2 4.2a.75.75 0 0 1-1.1 0L5.2 8.3a.75.75 0 0 1 0-1.1Z" clip-rule="evenodd" />
                </svg>
            </summary>
            <div class="discovery-filter-content">
                <div class="grid gap-4 md:grid-cols-3">
                    <div class="field-group">
                        <label for="discovery-genre" class="field-label">장르</label>
                        <select id="discovery-genre" class="field-input" name="genre">
                            <option value="">전체 장르</option>
                            @foreach (var genre in Model.Catalog.Genres)
                            {
                                <option value="@genre.Code" selected="@(Model.GenreCode == genre.Code)">@genre.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="field-group">
                        <label for="discovery-created-from" class="field-label">등록 시작 시각</label>
                        <input id="discovery-created-from"
                               class="field-input"
                               type="text"
                               name="createdFrom"
                               value="@Model.CreatedFrom"
                               placeholder="2026-08-01T00:00:00+09:00" />
                    </div>
                    <div class="field-group">
                        <label for="discovery-created-before" class="field-label">등록 종료 시각</label>
                        <input id="discovery-created-before"
                               class="field-input"
                               type="text"
                               name="createdBefore"
                               value="@Model.CreatedBefore"
                               placeholder="2026-09-01T00:00:00+09:00" />
                    </div>
                </div>

                <fieldset class="field-group">
                    <legend class="field-label">태그 <span class="text-meta">선택한 항목을 모두 포함</span></legend>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var tag in Model.Catalog.Tags)
                        {
                            <label class="field-choice">
                                <input type="checkbox"
                                       class="field-check"
                                       name="tags"
                                       value="@tag.Code"
                                       checked="@Model.TagCodes.Contains(tag.Code)" />
                                <span>@tag.DisplayName</span>
                            </label>
                        }
                    </div>
                </fieldset>

                <fieldset class="field-group">
                    <legend class="field-label">지원 플랫폼 <span class="text-meta">하나 이상 일치</span></legend>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var platform in Model.Catalog.Platforms)
                        {
                            <label class="field-choice">
                                <input type="checkbox"
                                       class="field-check"
                                       name="platforms"
                                       value="@platform.Code"
                                       checked="@Model.PlatformCodes.Contains(platform.Code)" />
                                <span>@platform.DisplayName</span>
                            </label>
                        }
                    </div>
                </fieldset>

                <div class="button-group">
                    <button type="submit" class="button-primary">필터 적용</button>
                    @if (Model.HasFilters)
                    {
                        <a asp-page="/Index" class="button-outline">조건 초기화</a>
                    }
                </div>
            </div>
        </details>
    </form>
</section>

@if (Model.Violations.Count > 0)
{
    <div class="alert-danger mb-6" role="alert" data-discovery-validation>
        <p class="alert-title">검색 조건을 확인해 주세요.</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
            @foreach (var violation in Model.Violations)
            {
                <li>@violation.Message</li>
            }
        </ul>
    </div>
}

<section id="game-discovery-results" aria-labelledby="game-discovery-title">
<div class="discovery-results-heading">
    <div>
        <p class="home-eyebrow">DISCOVER</p>
        <h2 id="game-discovery-title" class="section-title mb-0">@(Model.HasFilters ? "검색 결과" : "새로 등록된 게임")</h2>
    </div>
    @if (Model.HasFilters)
    {
        <a asp-page="/Index" class="text-link">전체 게임 보기</a>
    }
</div>
@if (Model.Games.Count == 0)
{
    <div class="alert-neutral">
        @(Model.HasFilters ? "조건에 맞는 게임이 없습니다." : "아직 등록된 게임이 없습니다.")
    </div>
}
else
{
    <div class="game-card-grid">
        @foreach (var game in Model.Games)
        {
            <a asp-page="/Games/Detail"
               asp-route-id="@game.Id"
               class="game-card group"
               data-discovery-result>
                <div class="game-card-media">
                    @if (Model.Covers.TryGetValue(game.Id, out var cover))
                    {
                        <img data-game-list-cover
                             data-media-id="@cover.MediaId"
                             src="@cover.Url"
                             alt="@game.Title 대표 이미지"
                             class="size-full object-cover"
                             width="640"
                             height="360"
                             loading="lazy"
                             decoding="async"
                             referrerpolicy="no-referrer" />
                    }
                    else
                    {
                        <div class="game-card-fallback"
                             data-game-list-cover-fallback
                             aria-hidden="true">
                            <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 10.5h-3m1.5-1.5v3m9.5-1.5h.01m1.99 2h.01M8.7 6h6.6a5.2 5.2 0 0 1 5 6.7l-1.1 3.7a2.1 2.1 0 0 1-3.6.8l-1.2-1.4a3.2 3.2 0 0 0-4.8 0l-1.2 1.4a2.1 2.1 0 0 1-3.6-.8l-1.1-3.7A5.2 5.2 0 0 1 8.7 6Z" />
                            </svg>
                            <span>대표 이미지 준비 중</span>
                        </div>
                    }
                </div>
                <div class="game-card-body">
                    <time class="text-meta" datetime="@game.CreatedAt.ToString("O")">@game.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</time>
                    <h3 class="game-card-title">@game.Title</h3>
                    <p class="game-card-description">@(game.Description ?? "아직 게임 소개가 없습니다.")</p>
                    <span class="game-card-action">게임 보기 <span aria-hidden="true">→</span></span>
                </div>
            </a>
        }
    </div>
}

@if (Model.NextPageUrl is not null)
{
    <div class="mt-6 flex justify-center">
        <a data-discovery-next href="@Model.NextPageUrl" class="button-outline">다음 게임 보기</a>
    </div>
}
</section>
