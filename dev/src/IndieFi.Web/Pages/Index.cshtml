@page
@model IndexModel
@{
    ViewData["Title"] = "홈";
}

@if (TempData["SignupMessage"] is string signupMessage)
{
    <div class="alert-success">@signupMessage</div>
}

<div class="mb-10 py-6 text-center">
    <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Indie-Fi</h1>
    <p class="mt-2 text-slate-500">인디 게임 피드백 플랫폼</p>
</div>

<h2 class="section-title">게임 둘러보기</h2>
@if (Model.Games.Count == 0)
{
    <div class="alert-neutral">아직 등록된 게임이 없습니다.</div>
}
else
{
    <div class="surface-list">
        @foreach (var game in Model.Games)
        {
            <a asp-page="/Games/Detail" asp-route-id="@game.Id" class="surface-item surface-link">
                <div class="flex items-center justify-between gap-4">
                    <span class="font-semibold">@game.Title</span>
                    <span class="text-meta">@game.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                </div>
                @if (game.Description is not null)
                {
                    <div>@game.Description</div>
                }
                else
                {
                    <div class="text-slate-500">(소개 없음)</div>
                }
            </a>
        }
    </div>
}
