@page
@model IndexModel
@{
    ViewData["Title"] = "홈";
    ViewData["MainClass"] = "site-main-home";
    var featuredGame = Model.Games.FirstOrDefault();
}

@if (TempData["SignupMessage"] is string signupMessage)
{
    <div class="home-status-wrap">
        <div class="alert-success" role="status">@signupMessage</div>
    </div>
}

<div class="home-layout">
    <aside class="home-sidebar" aria-label="게임 탐색 바로가기">
        <div class="home-sidebar-card">
            <p class="home-sidebar-label">PLAY · REVIEW · GROW</p>
            <h2 class="home-sidebar-title">플레이 경험을<br />좋은 피드백으로</h2>
            <p class="home-sidebar-copy">다른 개발자의 게임을 리뷰하고, 내 게임에 필요한 피드백을 받아보세요.</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Reviews/Index" class="home-sidebar-primary">리뷰할 게임 찾기</a>
                <a asp-page="/Credits/Index" class="home-sidebar-secondary">내 크레딧 보기 →</a>
            }
            else
            {
                <a asp-page="/Signup" class="home-sidebar-primary">무료로 시작하기</a>
                <a asp-page="/Login" class="home-sidebar-secondary">이미 계정이 있어요 →</a>
            }
        </div>

        <div class="home-sidebar-section">
            <h2 class="home-sidebar-label">태그로 찾기</h2>
            <div class="home-sidebar-link-grid">
                @foreach (var tag in Model.Catalog.Tags.Take(8))
                {
                    <a asp-page="/Index" asp-route-tags="@tag.Code">@tag.DisplayName</a>
                }
            </div>
            <a href="#discovery-filter-title" class="home-sidebar-more">전체 태그 보기 →</a>
        </div>

        <div class="home-sidebar-section">
            <h2 class="home-sidebar-label">장르</h2>
            <div class="home-sidebar-link-grid">
                @foreach (var genre in Model.Catalog.Genres.Take(8))
                {
                    <a asp-page="/Index" asp-route-genre="@genre.Code">@genre.DisplayName</a>
                }
            </div>
        </div>

        <div class="home-sidebar-section home-sidebar-section-divided">
            <h2 class="home-sidebar-label">플랫폼</h2>
            <div class="home-sidebar-link-grid">
                @foreach (var platform in Model.Catalog.Platforms)
                {
                    <a asp-page="/Index" asp-route-platforms="@platform.Code">@platform.DisplayName</a>
                }
            </div>
        </div>
    </aside>

    <div class="home-content">
        <section class="home-hero" data-home-hero aria-label="추천 게임과 게임 검색">
            @if (featuredGame is not null)
            {
                <a asp-page="/Games/Detail"
                   asp-route-id="@featuredGame.Id"
                   class="home-featured-game">
                    @if (Model.Covers.TryGetValue(featuredGame.Id, out var featuredCover))
                    {
                        <img src="@featuredCover.Url"
                             alt=""
                             width="960"
                             height="540"
                             decoding="async"
                             referrerpolicy="no-referrer" />
                    }
                    else
                    {
                        <div class="home-featured-fallback" aria-hidden="true">
                            <span>INDIE-FI</span>
                        </div>
                    }
                    <span class="home-featured-shade" aria-hidden="true"></span>
                    <span class="home-featured-copy">
                        <span class="home-featured-badge">@(Model.HasFilters ? "검색 결과" : "새로 등록됨")</span>
                        <strong class="home-featured-title">@featuredGame.Title</strong>
                        <span class="home-featured-date">@featuredGame.CreatedAt.ToLocalTime().ToString("yyyy.MM.dd") 등록</span>
                        <span class="home-featured-description">@(featuredGame.Description ?? "아직 게임 소개가 없습니다.")</span>
                        <span class="home-featured-action">게임 자세히 보기 →</span>
                    </span>
                </a>
            }
            else
            {
                <div class="home-featured-game home-featured-empty">
                    <div class="home-featured-fallback" aria-hidden="true">
                        <span>INDIE-FI</span>
                    </div>
                    <span class="home-featured-shade" aria-hidden="true"></span>
                    <span class="home-featured-copy">
                        <span class="home-featured-badge">PLAY · REVIEW · GROW</span>
                        <strong class="home-featured-title">새로운 인디 게임을 발견하세요.</strong>
                        <span class="home-featured-description">게임을 먼저 플레이하고 창작자에게 도움이 되는 피드백을 남길 수 있습니다.</span>
                    </span>
                </div>
            }

            <form method="get" data-discovery-filter class="home-search-panel">
                <div>
                    <p class="home-search-kicker">게임 탐색</p>
                    <h2 id="discovery-filter-title" class="home-search-title">어떤 게임을 찾고 있나요?</h2>
                    <p class="home-search-description">제목이나 소개를 검색하고 상세 조건을 적용해 보세요.</p>
                </div>
                <div class="home-search-row">
                    <label for="discovery-query" class="sr-only">제목·소개 검색</label>
                    <input id="discovery-query"
                           class="field-input home-search-input"
                           type="search"
                           name="q"
                           value="@Model.Query"
                           minlength="2"
                           maxlength="100"
                           placeholder="게임 제목이나 소개" />
                    <button type="submit" class="button-primary">검색</button>
                </div>

                <details class="discovery-filter-details"
                         open="@((Model.HasAdvancedFilters || Model.Violations.Count > 0) ? "open" : null)"
                         data-discovery-advanced>
                    <summary class="discovery-filter-summary">
                        <span>
                            <strong>상세 필터</strong>
                            <span class="text-meta ml-1">장르·태그·플랫폼·등록일</span>
                        </span>
                        <svg class="discovery-filter-chevron size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M5.2 7.2a.75.75 0 0 1 1.1 0L10 10.9l3.7-3.7a.75.75 0 1 1 1.1 1.1l-4.2 4.2a.75.75 0 0 1-1.1 0L5.2 8.3a.75.75 0 0 1 0-1.1Z" clip-rule="evenodd" />
                        </svg>
                    </summary>
                    <div class="discovery-filter-content">
                        <div class="field-group">
                            <label for="discovery-genre" class="field-label">장르</label>
                            <select id="discovery-genre" class="field-input" name="genre">
                                <option value="">전체 장르</option>
                                @foreach (var genre in Model.Catalog.Genres)
                                {
                                    <option value="@genre.Code" selected="@(Model.GenreCode == genre.Code)">@genre.DisplayName</option>
                                }
                            </select>
                        </div>

                        <fieldset class="field-group">
                            <legend class="field-label">태그 <span class="text-meta">모두 포함</span></legend>
                            <div class="home-filter-choices">
                                @foreach (var tag in Model.Catalog.Tags)
                                {
                                    <label class="field-choice">
                                        <input type="checkbox"
                                               class="field-check"
                                               name="tags"
                                               value="@tag.Code"
                                               checked="@Model.TagCodes.Contains(tag.Code)" />
                                        <span>@tag.DisplayName</span>
                                    </label>
                                }
                            </div>
                        </fieldset>

                        <fieldset class="field-group">
                            <legend class="field-label">지원 플랫폼 <span class="text-meta">하나 이상 일치</span></legend>
                            <div class="home-filter-choices">
                                @foreach (var platform in Model.Catalog.Platforms)
                                {
                                    <label class="field-choice">
                                        <input type="checkbox"
                                               class="field-check"
                                               name="platforms"
                                               value="@platform.Code"
                                               checked="@Model.PlatformCodes.Contains(platform.Code)" />
                                        <span>@platform.DisplayName</span>
                                    </label>
                                }
                            </div>
                        </fieldset>

                        <div class="home-filter-dates">
                            <div class="field-group">
                                <label for="discovery-created-from" class="field-label">등록 시작 시각</label>
                                <input id="discovery-created-from"
                                       class="field-input"
                                       type="text"
                                       name="createdFrom"
                                       value="@Model.CreatedFrom"
                                       placeholder="2026-08-01T00:00:00+09:00" />
                            </div>
                            <div class="field-group">
                                <label for="discovery-created-before" class="field-label">등록 종료 시각</label>
                                <input id="discovery-created-before"
                                       class="field-input"
                                       type="text"
                                       name="createdBefore"
                                       value="@Model.CreatedBefore"
                                       placeholder="2026-09-01T00:00:00+09:00" />
                            </div>
                        </div>

                        <div class="button-group">
                            <button type="submit" class="button-primary">필터 적용</button>
                            @if (Model.HasFilters)
                            {
                                <a asp-page="/Index" class="button-outline">조건 초기화</a>
                            }
                        </div>
                    </div>
                </details>
            </form>
        </section>

        @if (Model.Violations.Count > 0)
        {
            <div class="home-validation">
                <div class="alert-danger" role="alert" data-discovery-validation>
                    <p class="alert-title">검색 조건을 확인해 주세요.</p>
                    <ul class="mt-2 list-disc space-y-1 pl-5">
                        @foreach (var violation in Model.Violations)
                        {
                            <li>@violation.Message</li>
                        }
                    </ul>
                </div>
            </div>
        }

        <section id="game-discovery-results" class="home-releases" aria-labelledby="game-discovery-title">
            <div class="discovery-results-heading">
                <div class="home-release-heading">
                    <h2 id="game-discovery-title" class="section-title mb-0">@(Model.HasFilters ? "검색 결과" : "새로 등록된 게임")</h2>
                    <span class="home-release-tab">@(Model.HasFilters ? "FILTERED" : "NEW")</span>
                </div>
                @if (Model.HasFilters)
                {
                    <a asp-page="/Index" class="text-link">전체 게임 보기 →</a>
                }
            </div>
            @if (Model.Games.Count == 0)
            {
                <div class="empty-state" data-empty-state="game-discovery">
                    <div class="empty-state-icon" aria-hidden="true">◇</div>
                    <h3 class="empty-state-title">@(Model.HasFilters ? "조건에 맞는 게임이 없습니다." : "아직 등록된 게임이 없습니다.")</h3>
                    <p class="empty-state-description">
                        @(Model.HasFilters ? "검색어나 상세 필터를 줄여 다시 찾아보세요." : "첫 게임이 등록되면 이곳에서 바로 발견할 수 있습니다.")
                    </p>
                    <div class="empty-state-actions">
                        @if (Model.HasFilters)
                        {
                            <a asp-page="/Index" class="button-outline">검색 조건 지우기</a>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-page="/Games/New" class="button-primary">첫 게임 등록하기</a>
                        }
                        else
                        {
                            <a asp-page="/Signup" class="button-primary">가입하고 게임 등록하기</a>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="game-card-grid">
                    @foreach (var game in Model.Games)
                    {
                        <a asp-page="/Games/Detail"
                           asp-route-id="@game.Id"
                           class="game-card group"
                           data-discovery-result>
                            <div class="game-card-media">
                                @if (Model.Covers.TryGetValue(game.Id, out var cover))
                                {
                                    <img data-game-list-cover
                                         data-media-id="@cover.MediaId"
                                         src="@cover.Url"
                                         alt="@game.Title 대표 이미지"
                                         class="size-full object-cover"
                                         width="640"
                                         height="400"
                                         loading="lazy"
                                         decoding="async"
                                         referrerpolicy="no-referrer" />
                                }
                                else
                                {
                                    <div class="game-card-fallback"
                                         data-game-list-cover-fallback
                                         aria-hidden="true">
                                        <span>COVER 640×400</span>
                                    </div>
                                }
                            </div>
                            <div class="game-card-body">
                                <time class="text-meta" datetime="@game.CreatedAt.ToString("O")">@game.CreatedAt.ToLocalTime().ToString("yyyy.MM.dd")</time>
                                <h3 class="game-card-title">@game.Title</h3>
                                <p class="game-card-description">@(game.Description ?? "아직 게임 소개가 없습니다.")</p>
                                <span class="game-card-action">게임 보기 <span aria-hidden="true">→</span></span>
                            </div>
                        </a>
                    }
                </div>
            }

            @if (Model.NextPageUrl is not null)
            {
                <div class="mt-6 flex justify-center">
                    <a data-discovery-next href="@Model.NextPageUrl" class="button-outline">다음 게임 보기</a>
                </div>
            }
        </section>
    </div>
</div>
