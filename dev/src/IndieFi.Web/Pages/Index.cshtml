@page
@model IndexModel
@{
    ViewData["Title"] = "홈";
}

@if (TempData["SignupMessage"] is string signupMessage)
{
    <div class="alert alert-success">@signupMessage</div>
}

@if (TempData["GameMessage"] is string gameMessage)
{
    <div class="alert alert-success">@gameMessage</div>
}

<div class="text-center">
    <h1 class="display-4">Indie-Fi</h1>
    <p class="text-muted">인디 게임 피드백 플랫폼</p>

    @if (Model.DatabaseConnected)
    {
        <p class="text-success fw-bold">DB 연결: 정상</p>
    }
    else
    {
        <p class="text-danger fw-bold">DB 연결: 실패</p>
        <p class="text-muted small">@Model.DatabaseError</p>
    }
</div>
