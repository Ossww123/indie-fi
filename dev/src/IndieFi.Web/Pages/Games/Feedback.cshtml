@page "{id:long}"
@model FeedbackModel
@using IndieFi.Web.Modules.Feedback.Domain
@{
    ViewData["Title"] = $"{Model.GameTitle} - 받은 피드백";
}

<header class="page-heading">
    <div class="page-heading-copy">
        <p class="auth-eyebrow">RECEIVED FEEDBACK</p>
        <h1 class="page-title mt-2">@Model.GameTitle</h1>
        <p class="page-description">받은 피드백을 확인하고 유용성을 평가해 리뷰어 신뢰도에 반영하세요.</p>
    </div>
    <a asp-page="/Games/Detail" asp-route-id="@Model.GameId" class="button-outline">게임 상세</a>
</header>

<h2 class="section-title">받은 피드백</h2>
@if (Model.RatingMessage is not null)
{
    <div class="alert-success" role="status">@Model.RatingMessage</div>
}

@if (Model.Items.Count == 0)
{
    <div class="empty-state" data-empty-state="received-feedback">
        <div class="empty-state-icon" aria-hidden="true">◇</div>
        <h2 class="empty-state-title">아직 받은 피드백이 없습니다.</h2>
        <p class="empty-state-description">리뷰어가 배정된 작업을 완료하면 피드백과 품질 평가 항목이 이곳에 표시됩니다.</p>
        <div class="empty-state-actions">
            <a asp-page="/Games/Detail" asp-route-id="@Model.GameId" class="button-outline">게임 상세로 돌아가기</a>
        </div>
    </div>
}
else
{
    <div class="space-y-5 mb-6">
        @foreach (var item in Model.Items)
        {
            var useSubmittedValues = Model.PreserveSubmittedRating
                && Model.SubmittedFeedbackId == item.FeedbackId;
            var selectedScore = useSubmittedValues
                ? Model.SubmittedScore
                : item.RatingScore;
            var reason = useSubmittedValues
                ? Model.SubmittedReason
                : item.RatingReason;

            <article class="surface-card">
                <div class="text-meta">
                    <a asp-page="/Profiles/Detail"
                       asp-route-id="@item.ReviewerId"
                       class="text-link">@item.ReviewerDisplayName</a>
                    · 제출 @item.SubmittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </div>
                <div class="feedback-body">@item.Body</div>

                <section class="feedback-rating-panel"
                         aria-labelledby="rating-heading-@item.FeedbackId">
                    <h3 id="rating-heading-@item.FeedbackId" class="font-semibold text-slate-900">
                        피드백 품질 평가
                    </h3>

                    @if (item.RatingScore is int currentScore)
                    {
                        <p class="mt-2 text-sm text-slate-700" data-current-feedback-rating="@item.FeedbackId">
                            현재 평가: <strong>@(currentScore)점</strong>
                            (@FeedbackModel.GetScoreLabel(currentScore))
                        </p>
                        @if (item.RatingReason is not null)
                        {
                            <p class="mt-1 whitespace-pre-wrap text-sm text-slate-600">@item.RatingReason</p>
                        }
                    }
                    else
                    {
                        <p class="mt-2 text-sm text-slate-600">아직 평가하지 않았습니다.</p>
                    }

                    <p class="mt-1 text-xs text-slate-500">
                        평가 가능 기한: @item.RatingClosesAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </p>

                    @if (Model.SubmittedFeedbackId == item.FeedbackId
                        && Model.RatingErrors.Count > 0)
                    {
                        <div class="validation-summary-errors mt-3" role="alert">
                            <ul>
                                @foreach (var error in Model.RatingErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (item.CanRate)
                    {
                        <form method="post"
                              asp-page-handler="Rate"
                              asp-route-id="@Model.GameId"
                              data-feedback-rating-form="@item.FeedbackId"
                              class="mt-4 space-y-4">
                            <input type="hidden" name="feedbackId" value="@item.FeedbackId" />
                            @if (item.RatingRevision is int revision)
                            {
                                <input type="hidden" name="revision" value="@revision" />
                            }

                            <div class="field-group">
                                <label for="rating-score-@item.FeedbackId" class="field-label">유용성 점수</label>
                                <select id="rating-score-@item.FeedbackId"
                                        name="score"
                                        class="field-input"
                                        required>
                                    <option value="">점수를 선택해 주세요</option>
                                    <option value="1" selected="@(selectedScore == 1)">1점 — 매우 도움 안 됨</option>
                                    <option value="2" selected="@(selectedScore == 2)">2점 — 도움 안 됨</option>
                                    <option value="3" selected="@(selectedScore == 3)">3점 — 보통</option>
                                    <option value="4" selected="@(selectedScore == 4)">4점 — 도움 됨</option>
                                    <option value="5" selected="@(selectedScore == 5)">5점 — 매우 도움 됨</option>
                                </select>
                            </div>

                            <div class="field-group">
                                <label for="rating-reason-@item.FeedbackId" class="field-label">
                                    평가 사유 <span class="font-normal text-slate-500">(선택)</span>
                                </label>
                                <textarea id="rating-reason-@item.FeedbackId"
                                          name="reason"
                                          rows="3"
                                          maxlength="@FeedbackQualityPolicy.MaximumReasonLength"
                                          class="field-input"
                                          placeholder="어떤 점이 도움이 되었거나 아쉬웠는지 적어 주세요.">@reason</textarea>
                                <p class="text-xs text-slate-500">
                                    최대 @FeedbackQualityPolicy.MaximumReasonLength 자
                                </p>
                            </div>

                            <button type="submit" class="button-primary">
                                @(item.RatingScore is null ? "평가 등록" : "평가 수정")
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="mt-3 text-sm font-medium text-slate-600">평가 기간이 종료되었습니다.</p>
                    }
                </section>
            </article>
        }
    </div>
}

<a asp-page="/Games/Detail" asp-route-id="@Model.GameId" class="text-link">← 게임 상세로 돌아가기</a>
