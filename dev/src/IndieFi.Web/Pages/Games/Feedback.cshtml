@page "{id:long}"
@model FeedbackModel
@{
    ViewData["Title"] = $"{Model.GameTitle} - 받은 피드백";
}

<h1 class="page-title mb-6">@Model.GameTitle</h1>

<h2 class="subsection-title">받은 피드백</h2>
@if (Model.Items.Count == 0)
{
    <div class="alert-neutral">아직 받은 피드백이 없습니다.</div>
}
else
{
    <div class="surface-list mb-4">
        @foreach (var item in Model.Items)
        {
            <div class="surface-item">
                <div class="text-meta">
                    @item.ReviewerEmail · @item.SubmittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </div>
                <div class="mt-2 whitespace-pre-wrap leading-7 text-slate-700">@item.Body</div>
            </div>
        }
    </div>
}

<a asp-page="/Games/Detail" asp-route-id="@Model.GameId" class="text-link">게임 상세로 돌아가기</a>
