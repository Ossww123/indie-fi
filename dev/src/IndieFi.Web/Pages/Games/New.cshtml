@page
@model NewModel
@{
    ViewData["Title"] = "게임 등록";
    ViewData["MainClass"] = "site-main-game-editor";
}

<nav class="ivory-breadcrumb" aria-label="현재 위치">
    <a asp-page="/Games/Index">내 게임</a>
    <span aria-hidden="true">/</span>
    <span>새 게임</span>
</nav>

<header class="ivory-page-heading">
    <div>
        <p class="ivory-heading-label">NEW GAME</p>
        <h1>게임 등록</h1>
        <p>플레이어가 게임을 이해하고 직접 찾아갈 수 있도록 기본 정보와 플레이 경로를 입력합니다.</p>
    </div>
</header>

<div class="ivory-game-editor-layout" data-game-editor="new">
    <form method="post" class="ivory-game-editor-form">
        <div asp-validation-summary="ModelOnly" role="alert"></div>

        <section class="ivory-form-section" aria-labelledby="game-basic-heading">
            <div class="ivory-form-section-heading">
                <span>01</span>
                <div>
                    <h2 id="game-basic-heading">기본 정보</h2>
                    <p>게임을 처음 발견한 플레이어에게 보일 제목과 소개입니다.</p>
                </div>
            </div>

            <div class="field-group">
                <label asp-for="Title" class="field-label">게임 제목</label>
                <input asp-for="Title" class="field-input" autocomplete="off" />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="Description" class="field-label">소개</label>
                <textarea asp-for="Description" class="field-input ivory-game-description" rows="7"></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>
        </section>

        <section class="ivory-form-section" aria-labelledby="game-classification-heading">
            <div class="ivory-form-section-heading">
                <span>02</span>
                <div>
                    <h2 id="game-classification-heading">분류</h2>
                    <p>장르, 태그와 지원 플랫폼으로 탐색 결과에서 게임을 설명합니다.</p>
                </div>
            </div>
            <partial name="_GameClassificationFields" model="Model" />
        </section>

        <section class="ivory-form-section" aria-labelledby="game-link-heading">
            <div class="ivory-form-section-heading">
                <span>03</span>
                <div>
                    <h2 id="game-link-heading">플레이 경로</h2>
                    <p>Steam, itch.io 또는 개발자 사이트처럼 실제로 플레이할 수 있는 주소를 연결합니다.</p>
                </div>
            </div>
            <partial name="_GamePlayLinkFields" model="Model" />
        </section>

        <div class="ivory-editor-actions">
            <a asp-page="/Games/Index" class="button-link">취소</a>
            <button type="submit" class="button-primary">게임 등록</button>
        </div>
    </form>

    <aside class="ivory-game-editor-sidebar" aria-label="게임 등록 안내">
        <section class="ivory-side-card">
            <p class="ivory-card-label">PUBLISHING FLOW</p>
            <h2>등록 후 할 일</h2>
            <ol class="ivory-editor-steps">
                <li>
                    <span>1</span>
                    <div><strong>기본 정보 등록</strong><p>제목·소개·분류·링크를 저장합니다.</p></div>
                </li>
                <li>
                    <span>2</span>
                    <div><strong>미디어 구성</strong><p>대표 이미지와 스크린샷을 올립니다.</p></div>
                </li>
                <li>
                    <span>3</span>
                    <div><strong>운영 기능 연결</strong><p>피드백 요청과 키 배포를 관리합니다.</p></div>
                </li>
            </ol>
        </section>

        <section class="ivory-side-card ivory-editor-note">
            <p class="ivory-card-label">NOTE</p>
            <p>등록한 내용은 이후 내 게임의 수정 화면에서 다시 변경할 수 있습니다.</p>
        </section>
    </aside>
</div>

@section Scripts {
    <script type="module"
            src="~/js/dist/games/play-links.js"
            asp-append-version="true"></script>
}
