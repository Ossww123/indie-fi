@page "{id:long}"
@model DetailModel
@{
    ViewData["Title"] = Model.Game.Title;
}

@if (TempData["GameMessage"] is string gameMessage)
{
    <div class="alert alert-success">@gameMessage</div>
}

<div class="d-flex align-items-center gap-2">
    <h1 class="h3 mb-1">@Model.Game.Title</h1>
    @* Hiding this link is only UX; the Edit endpoint enforces ownership. *@
    @if (Model.IsOwner)
    {
        <a asp-page="/Games/Edit"
           asp-route-id="@Model.Game.Id"
           class="btn btn-outline-secondary btn-sm">수정</a>
    }
</div>
<p class="text-muted small">@Model.Game.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</p>

@if (Model.Game.Description is not null)
{
    <p>@Model.Game.Description</p>
}
else
{
    <p class="text-muted">(소개 없음)</p>
}

<a asp-page="/Games/Index" class="btn btn-link px-0">← 목록으로</a>
