@page "{id:long}"
@model DetailModel
@{
    ViewData["Title"] = Model.Game.Title;
}

@if (TempData["GameMessage"] is string gameMessage)
{
    <div class="alert alert-success">@gameMessage</div>
}

@if (Model.RequestMessage is { } requestMessage)
{
    <div class="alert @(requestMessage.IsSuccess ? "alert-success" : "alert-warning")">
        @requestMessage.Message
    </div>
}

<div class="d-flex align-items-center gap-2">
    <h1 class="h3 mb-1">@Model.Game.Title</h1>
    @* Hiding this link is only UX; the Edit endpoint enforces ownership. *@
    @if (Model.IsOwner)
    {
        <a asp-page="/Games/Edit"
           asp-route-id="@Model.Game.Id"
           class="btn btn-outline-secondary btn-sm">수정</a>
        <a asp-page="/KeyDrops/New"
           asp-route-gameId="@Model.Game.Id"
           class="btn btn-outline-secondary btn-sm">드롭 예약</a>
        @* Hiding this button is only UX; the handler enforces ownership. *@
        <form method="post"
              asp-page-handler="RequestFeedback"
              asp-route-id="@Model.Game.Id">
            <button type="submit" class="btn btn-outline-secondary btn-sm">피드백 요청</button>
        </form>
    }
</div>
<p class="text-muted small">@Model.Game.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</p>

@if (Model.Game.Description is not null)
{
    <p>@Model.Game.Description</p>
}
else
{
    <p class="text-muted">(소개 없음)</p>
}

<p class="text-muted">대기 중인 피드백 요청 @(Model.PendingRequestCount)개</p>
@if (Model.IsOwner)
{
    <p><a asp-page="/Games/Feedback" asp-route-id="@Model.Game.Id">받은 피드백 보기</a></p>
}

<h2 class="h5 mt-4">예약된 드롭</h2>
@if (Model.Drops.Count == 0)
{
    <div class="alert alert-secondary">예약된 드롭 없음</div>
}
else
{
    <div class="list-group">
        @foreach (var drop in Model.Drops)
        {
            <a asp-page="/KeyDrops/Detail"
               asp-route-id="@drop.Id"
               class="list-group-item list-group-item-action">
                <div class="d-flex justify-content-between align-items-center">
                    <span>@drop.OpensAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    @if (drop.IsOpen)
                    {
                        <span class="badge bg-success">진행 중</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">오픈 예정</span>
                    }
                </div>
            </a>
        }
    </div>
}

<a asp-page="/Games/Index" class="btn btn-link px-0">← 목록으로</a>
