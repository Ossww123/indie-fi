@page
@model IndexModel
@{
    ViewData["Title"] = "내 게임";
}

<div class="mb-6 flex items-start justify-between gap-4">
    <h1 class="page-title">내 게임</h1>
    <a asp-page="/Games/New" class="button-primary">게임 등록</a>
</div>

@if (TempData["GameMessage"] is string gameMessage)
{
    <div class="alert-success">@gameMessage</div>
}

@if (Model.Games.Count == 0)
{
    <div class="alert-neutral">등록한 게임이 없습니다. 첫 게임을 등록해 보세요.</div>
}
else
{
    <div class="surface-list">
        @foreach (var game in Model.Games)
        {
            <a asp-page="/Games/Detail" asp-route-id="@game.Id" class="surface-item surface-link">
                <div class="flex items-center justify-between gap-4">
                    <span class="font-semibold">@game.Title</span>
                    <span class="text-meta">@game.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                </div>
                @if (game.Description is not null)
                {
                    <div>@game.Description</div>
                }
                else
                {
                    <div class="text-slate-500">(소개 없음)</div>
                }
            </a>
        }
    </div>
}
