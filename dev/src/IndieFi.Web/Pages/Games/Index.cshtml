@page
@model IndexModel
@{
    ViewData["Title"] = "내 게임";
}

<header class="page-heading">
    <div class="page-heading-copy">
        <h1 class="page-title">내 게임</h1>
        <p class="page-description">등록한 게임의 공개 정보, 미디어, 피드백 요청과 키 배포를 관리합니다.</p>
    </div>
    <a asp-page="/Games/New" class="button-primary">게임 등록</a>
</header>

<partial name="_AccountTools" />

@if (TempData["GameMessage"] is string gameMessage)
{
    <div class="alert-success" role="status">@gameMessage</div>
}

@if (Model.Games.Count == 0)
{
    <div class="empty-state" data-empty-state="owned-games">
        <div class="empty-state-icon" aria-hidden="true">◇</div>
        <h2 class="empty-state-title">등록한 게임이 없습니다.</h2>
        <p class="empty-state-description">게임 기본 정보를 등록한 뒤 미디어, 피드백과 키 배포를 차례로 관리할 수 있습니다.</p>
        <div class="empty-state-actions">
            <a asp-page="/Games/New" class="button-primary">첫 게임 등록하기</a>
        </div>
    </div>
}
else
{
    <div class="account-card-grid">
        @foreach (var game in Model.Games)
        {
            <a asp-page="/Games/Detail" asp-route-id="@game.Id" class="surface-card surface-link overflow-hidden p-0 sm:p-0">
                <div class="flex h-full flex-col">
                    @if (Model.Covers.TryGetValue(game.Id, out var cover))
                    {
                        <img data-game-list-cover
                             data-media-id="@cover.MediaId"
                             src="@cover.Url"
                             alt="@game.Title 대표 이미지"
                             class="aspect-video w-full object-cover"
                             width="176"
                             height="112"
                             loading="lazy"
                             decoding="async"
                             referrerpolicy="no-referrer" />
                    }
                    else
                    {
                        <div class="flex aspect-video w-full items-center justify-center bg-brand-soft/25 text-meta"
                             data-game-list-cover-fallback
                             aria-hidden="true">이미지 없음</div>
                    }
                    <div class="min-w-0 flex-1 p-5">
                        <div class="flex items-center justify-between gap-4">
                            <span class="font-semibold">@game.Title</span>
                            <span class="text-meta">@game.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                        </div>
                        @if (game.Description is not null)
                        {
                            <div class="mt-2 text-sm text-brand-ink/70">@game.Description</div>
                        }
                        else
                        {
                            <div class="mt-2 text-slate-500">(소개 없음)</div>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
}
