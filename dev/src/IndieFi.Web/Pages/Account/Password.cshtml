@page
@model PasswordModel
@{
    ViewData["Title"] = "비밀번호 변경";
}

<header class="page-heading">
    <div class="page-heading-copy">
        <h1 class="page-title">비밀번호 변경</h1>
        <p class="page-description">변경이 완료되면 계정 보호를 위해 모든 기기에서 로그아웃됩니다.</p>
    </div>
</header>

<partial name="_AccountTools" />

<form method="post" class="editor-card auth-form max-w-xl">
    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <div class="field-group">
        <label asp-for="CurrentPassword" class="field-label">현재 비밀번호</label>
        <input asp-for="CurrentPassword" class="field-input" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword" class="field-error"></span>
    </div>

    <div class="field-group">
        <label asp-for="NewPassword" class="field-label">새 비밀번호</label>
        <input asp-for="NewPassword" class="field-input" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>

    <div class="field-group">
        <label asp-for="ConfirmNewPassword" class="field-label">새 비밀번호 확인</label>
        <input asp-for="ConfirmNewPassword" class="field-input" autocomplete="new-password" />
        <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
    </div>

    <button type="submit" class="button-primary">비밀번호 변경</button>
</form>
