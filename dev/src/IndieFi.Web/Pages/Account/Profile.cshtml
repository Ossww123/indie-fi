@page
@model ProfileModel
@using IndieFi.Web.Modules.Media.Domain
@{
    ViewData["Title"] = "내 프로필";
}

<header class="page-heading">
    <div class="page-heading-copy">
        <h1 class="page-title">내 프로필</h1>
        <p class="page-description">다른 사용자에게 공개할 이미지, 닉네임과 소개를 관리합니다.</p>
    </div>
    <div class="button-group" aria-label="프로필 관련 메뉴">
        <a asp-page="/Profiles/Detail"
           asp-route-id="@Model.PublicProfileUserId"
           class="button-outline">공개 프로필 보기</a>
        <a asp-page="/Account/Following" class="button-link">팔로잉 목록</a>
        <a asp-page="/Account/FavoriteGames" class="button-link">관심 게임</a>
        <a asp-page="/Account/Notifications" class="button-link">알림 설정</a>
    </div>
</header>

<partial name="_AccountTools" />

@if (Model.StatusMessage is not null)
{
    <div class="alert-success mb-6" role="status">@Model.StatusMessage</div>
}

@if (Model.Media is not null)
{
    var currentImage = Model.Media.Images.FirstOrDefault(item => item.IsCurrent);
    <section data-profile-media
             data-profile-user-id="@Model.Media.UserId"
             data-max-file-bytes="@Model.MaximumProfileImageBytes"
             data-media-api-base="/api/media"
             class="surface-card mb-8"
             aria-labelledby="profile-image-heading">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-4">
            <div>
                <h2 id="profile-image-heading" class="subsection-title">프로필 이미지</h2>
                <p class="mt-1 text-meta">
                    새 이미지가 준비되면 현재 이미지를 교체합니다.
                </p>
            </div>
            <form data-media-upload-form
                  data-attachment-kind="ProfileImage"
                  data-media-upload-mode="@(currentImage is null ? "create" : "replace")"
                  class="flex flex-wrap items-end gap-2">
                <div class="field-group">
                    <label for="profile-image-file" class="field-label">프로필 이미지 파일</label>
                    <input id="profile-image-file"
                           data-media-file
                           class="field-input"
                           type="file"
                           accept="image/jpeg,image/png,image/webp" />
                </div>
                <button type="button"
                        data-media-upload-submit
                        class="button-primary"
                        disabled>@(currentImage is null ? "업로드" : "교체 업로드")</button>
                <button type="button"
                        data-media-upload-cancel
                        class="button-outline hidden"
                        disabled>취소</button>
            </form>
        </div>

        <div class="alert-neutral mb-4">
            JPEG·PNG·WebP 정지 이미지를 최대 5 MiB까지 올릴 수 있습니다.
        </div>
        <div class="alert-neutral mb-4 hidden"
             data-media-notice
             role="status"
             aria-live="polite"></div>

        @if (currentImage?.PreviewUrl is not null)
        {
            <img data-media-id="@currentImage.MediaId"
                 src="@currentImage.PreviewUrl"
                 alt="현재 프로필 이미지"
                 class="mb-4 size-28 rounded-full object-cover"
                 width="112"
                 height="112"
                 data-media-preview />
        }
        else
        {
            <div class="mb-4 flex size-28 items-center justify-center rounded-full bg-indigo-100 text-indigo-700"
                 data-default-profile-image>
                <svg class="size-14"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     role="img"
                     aria-label="기본 프로필 이미지">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.12a7.5 7.5 0 0 1 15 0A17.9 17.9 0 0 1 12 21.75a17.9 17.9 0 0 1-7.5-1.63Z" />
                </svg>
            </div>
        }

        <div class="surface-list" data-media-list="ProfileImage">
            @if (Model.Media.Images.Count == 0)
            {
                <div class="surface-item text-meta" data-media-empty>
                    등록된 프로필 이미지가 없습니다.
                </div>
            }
            else
            {
                @foreach (var item in Model.Media.Images)
                {
                    <article class="surface-item"
                             data-media-item
                             data-media-id="@item.MediaId"
                             data-media-status="@item.Status"
                             data-attachment-kind="ProfileImage">
                        <div class="flex flex-wrap items-center gap-4">
                            @if (item.PreviewUrl is not null)
                            {
                                <img src="@item.PreviewUrl"
                                     alt="프로필 이미지 미리보기"
                                     class="size-20 rounded-full object-cover"
                                     width="80"
                                     height="80"
                                     data-media-preview />
                            }
                            <div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="font-semibold" data-media-status-text>
                                        @ProfileModel.MediaStatusText(item.Status)
                                    </span>
                                    @if (item.IsCurrent)
                                    {
                                        <span class="badge-success">현재 공개</span>
                                    }
                                </div>
                                <p class="mt-1 text-meta">
                                    @ProfileModel.FormatBytes(item.DeclaredBytes)
                                    · 처리 시도 @item.ProcessingAttemptCount 회
                                    · 갱신 @item.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                </p>
                                @if (item.FailureCode is not null)
                                {
                                    <p class="mt-2 field-error" data-media-failure>
                                        오류 코드: @item.FailureCode
                                    </p>
                                }
                                @if (ProfileModel.CanRemoveMedia(item.Status))
                                {
                                    <div class="mt-3" data-media-actions>
                                        <button type="button"
                                                data-media-action="remove"
                                                class="button-danger button-small"
                                                aria-label="프로필 이미지 제거"
                                                disabled>제거</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
}

<section class="surface-card" aria-labelledby="profile-information-heading">
    <h2 id="profile-information-heading" class="subsection-title">공개 프로필 정보</h2>
    <p class="mb-5 text-meta">닉네임과 소개는 공개 프로필과 게임의 개발자 정보에 표시됩니다.</p>
<form method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <div class="field-group">
        <label asp-for="Nickname" class="field-label">닉네임</label>
        <input asp-for="Nickname"
               class="field-input"
               maxlength="@Model.NicknameMaxLength"
               autocomplete="nickname"
               readonly="@(!Model.CanChangeNickname ? "readonly" : null)" />
        <span asp-validation-for="Nickname" class="field-error"></span>
        @if (Model.CanChangeNickname)
        {
            <p class="text-sm text-slate-500">
                @Model.NicknameMinLength~@(Model.NicknameMaxLength)자의 한글, 영문, 숫자, 공백, 밑줄과 하이픈을 사용할 수 있습니다.
                비워 두면 <strong>@Model.FallbackDisplayIdentifier</strong>로 표시되며, 설정·변경·해제 후 7일 동안 다시 바꿀 수 없습니다.
            </p>
        }
        else if (Model.NicknameChangeAvailableAt is DateTimeOffset availableAt)
        {
            <p class="text-sm text-slate-500">
                다음 변경 가능 시각:
                <time datetime="@availableAt.ToString("O")">@availableAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</time>
            </p>
        }
    </div>

    <div class="field-group">
        <label asp-for="Biography" class="field-label">소개</label>
        <textarea asp-for="Biography"
                  class="field-input min-h-40"
                  rows="8"></textarea>
        <span asp-validation-for="Biography" class="field-error"></span>
        <p class="text-sm text-slate-500">최대 @(Model.BiographyMaxLength)자까지 입력할 수 있습니다.</p>
    </div>

    <button type="submit" class="button-primary">프로필 저장</button>
</form>
</section>

@section Scripts {
    @if (Model.Media is not null)
    {
        <script type="module"
                src="~/js/dist/account/profile-media.js"
                asp-append-version="true"></script>
    }
}
