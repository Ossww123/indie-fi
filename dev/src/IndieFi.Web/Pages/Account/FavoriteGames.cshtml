@page
@model FavoriteGamesModel
@{
    ViewData["Title"] = "관심 게임";
}

<header class="page-heading">
    <div class="page-heading-copy">
        <h1 class="page-title">관심 게임</h1>
        <p class="page-description">다시 살펴보고 싶은 게임을 모아 둔 개인 목록입니다.</p>
    </div>
</header>

<partial name="_AccountTools" />

@if (Model.Items.Count == 0)
{
    <div class="alert-neutral">아직 관심 게임이 없습니다.</div>
}
else
{
    <div class="account-card-grid">
        @foreach (var item in Model.Items)
        {
            <article class="surface-card">
                <div class="flex items-center justify-between gap-4">
                    <a asp-page="/Games/Detail"
                       asp-route-id="@item.GameId"
                       class="text-link font-semibold">@item.Title</a>
                    <span class="text-meta">@item.FavoritedAt.ToLocalTime().ToString("yyyy-MM-dd") 등록</span>
                </div>
                <p class="mt-2 text-sm text-slate-600">
                    개발자
                    <a asp-page="/Profiles/Detail"
                       asp-route-id="@item.OwnerId"
                       class="text-link">@item.OwnerDisplayName</a>
                </p>
                @if (item.Description is null)
                {
                    <div class="mt-2 text-slate-500">(소개 없음)</div>
                }
                else
                {
                    <div class="mt-2">@item.Description</div>
                }
            </article>
        }
    </div>
}
