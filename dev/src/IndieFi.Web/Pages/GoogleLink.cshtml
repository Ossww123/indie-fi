@page
@model GoogleLinkModel
@{
    ViewData["Title"] = "Google 계정 연결";
}

<h1 class="page-title mb-4">Google 계정 연결</h1>
<p class="mb-6 text-sm text-slate-600">
    같은 이메일의 기존 계정을 보호하기 위해 현재 비밀번호를 다시 확인합니다.
</p>

<form method="post" class="form-stack">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="field-group">
        <label asp-for="Password" class="field-label">현재 비밀번호</label>
        <input asp-for="Password" class="field-input" autocomplete="current-password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <button type="submit" class="button-primary">확인하고 Google 연결</button>
</form>
