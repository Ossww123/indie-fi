@page
@model GoogleLinkModel
@{
    ViewData["Title"] = "Google 계정 연결";
}

<section class="auth-shell" data-auth-page="google-link">
    <header class="auth-header">
        <p class="auth-eyebrow">SECURE LINK</p>
        <h1 class="auth-title">Google 계정 연결</h1>
        <p class="auth-description">같은 이메일의 기존 계정을 보호하기 위해 현재 비밀번호를 다시 확인합니다.</p>
    </header>

    <div class="auth-card">
        <form method="post" class="auth-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="field-group">
                <label asp-for="Password" class="field-label">현재 비밀번호</label>
                <input asp-for="Password" class="field-input" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <button type="submit" class="button-primary w-full">확인하고 Google 연결</button>
        </form>
    </div>
</section>
