@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "비밀번호 재설정";
}

<h1 class="page-title mb-6">비밀번호 재설정</h1>

@if (Model.State == PasswordResetPageState.ResetCompleted)
{
    <div class="alert-success mb-6" role="status">
        비밀번호가 재설정되었습니다. 새 비밀번호로 다시 로그인해 주세요.
    </div>
    <a asp-page="/Login" class="button-primary">로그인하기</a>
}
else if (Model.State == PasswordResetPageState.Invalid)
{
    <div class="alert-warning mb-6" role="alert">
        유효하지 않거나 만료된 비밀번호 재설정 링크입니다.
    </div>
    <a asp-page="/ForgotPassword" class="button-primary">재설정 메일 다시 받기</a>
}
else if (Model.State == PasswordResetPageState.ReadyToReset)
{
    <p class="mb-6 text-sm text-slate-600">
        사용할 새 비밀번호를 입력해 주세요.
    </p>

    <form method="post" asp-page="/ResetPassword" class="form-stack">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="Token" />

        <div class="field-group">
            <label asp-for="NewPassword" class="field-label">새 비밀번호</label>
            <input asp-for="NewPassword" class="field-input" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>

        <div class="field-group">
            <label asp-for="ConfirmNewPassword" class="field-label">새 비밀번호 확인</label>
            <input asp-for="ConfirmNewPassword" class="field-input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
        </div>

        <button type="submit" class="button-primary">비밀번호 재설정</button>
    </form>
}
else
{
    <div class="alert-neutral mb-6">
        비밀번호 재설정 메일의 링크를 열어 주세요.
    </div>
    <a asp-page="/ForgotPassword" class="button-link">재설정 메일 받기</a>
}
