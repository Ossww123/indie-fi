@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "비밀번호 재설정";
    ViewData["MainClass"] = "site-main-auth";
}

<section class="auth-shell ivory-auth-shell" data-auth-page="reset-password">
    <div class="ivory-auth-panel">
        <nav class="ivory-auth-tabs" aria-label="인증 메뉴">
            <a asp-page="/Login">SIGN IN</a>
            <a asp-page="/Signup">SIGN UP</a>
            <span aria-current="page">RESET</span>
        </nav>

        <header class="auth-header">
            <p class="auth-eyebrow">ACCOUNT RECOVERY</p>
            <h1 class="auth-title">비밀번호 재설정</h1>
            <p class="auth-description">안전한 새 비밀번호로 계정 접근을 복구하세요.</p>
        </header>

        <div class="auth-card ivory-auth-state-card">
            @if (Model.State == PasswordResetPageState.ResetCompleted)
            {
                <div class="ivory-auth-state-icon ivory-auth-state-success" aria-hidden="true">✓</div>
                <h2>새 비밀번호를 저장했습니다.</h2>
                <div class="alert-success" role="status">비밀번호가 재설정되었습니다. 새 비밀번호로 다시 로그인해 주세요.</div>
                <div class="auth-state-actions">
                    <a asp-page="/Login" class="button-primary w-full">로그인하기</a>
                </div>
            }
            else if (Model.State == PasswordResetPageState.Invalid)
            {
                <div class="ivory-auth-state-icon ivory-auth-state-warning" aria-hidden="true">!</div>
                <h2>링크를 사용할 수 없습니다.</h2>
                <div class="alert-warning" role="alert">유효하지 않거나 만료된 비밀번호 재설정 링크입니다.</div>
                <div class="auth-state-actions">
                    <a asp-page="/ForgotPassword" class="button-primary w-full">재설정 메일 다시 받기</a>
                </div>
            }
            else if (Model.State == PasswordResetPageState.ReadyToReset)
            {
                <div class="ivory-auth-state-icon" aria-hidden="true">●</div>
                <h2>새 비밀번호 입력</h2>
                <p class="ivory-auth-state-intro">사용할 새 비밀번호를 두 번 입력해 주세요.</p>
                <form method="post" asp-page="/ResetPassword" class="auth-form">
                    <div asp-validation-summary="ModelOnly" role="alert"></div>
                    <input type="hidden" asp-for="Token" />
                    <div class="field-group">
                        <label asp-for="NewPassword" class="field-label">새 비밀번호</label>
                        <input asp-for="NewPassword" class="field-input" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="field-error"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="ConfirmNewPassword" class="field-label">새 비밀번호 확인</label>
                        <input asp-for="ConfirmNewPassword" class="field-input" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
                    </div>
                    <button type="submit" class="button-primary w-full">비밀번호 재설정</button>
                </form>
            }
            else
            {
                <div class="ivory-auth-state-icon" aria-hidden="true">✉</div>
                <h2>재설정 메일을 열어 주세요.</h2>
                <div class="alert-neutral">비밀번호 재설정 메일의 링크를 열어 주세요.</div>
                <div class="auth-state-actions">
                    <a asp-page="/ForgotPassword" class="button-outline w-full">재설정 메일 받기</a>
                </div>
            }
        </div>
    </div>

    <aside class="ivory-auth-visual ivory-auth-visual-reset" aria-label="계정 복구 안내">
        <div class="ivory-auth-mark" aria-hidden="true">↺</div>
        <div class="ivory-auth-visual-copy">
            <p>ONE-TIME RECOVERY</p>
            <h2>새 비밀번호로<br />계정 접근을 복구하세요.</h2>
        </div>
    </aside>
</section>
