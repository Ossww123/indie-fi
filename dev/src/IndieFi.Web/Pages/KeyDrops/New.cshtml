@page
@model NewModel
@{
    ViewData["Title"] = "드롭 예약";
}

<h1 class="page-title">드롭 예약</h1>
<p class="mb-6 text-slate-500">@Model.Game.Title</p>

<form method="post"
      asp-route-gameId="@Model.Game.Id"
      data-key-drop-form
      class="form-stack">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="field-group">
        <label asp-for="OpensAt" class="field-label">오픈 시각</label>
        <input asp-for="OpensAt" type="datetime-local" class="field-input" />
        <span asp-validation-for="OpensAt" class="field-error"></span>
    </div>

    <div class="field-group">
        <label asp-for="KeysText" class="field-label">스팀 키</label>
        <textarea asp-for="KeysText"
                  class="field-input"
                  rows="8"
                  placeholder="한 줄에 키 하나"></textarea>
        <span asp-validation-for="KeysText" class="field-error"></span>
        <p class="text-sm text-slate-500">
            키 하나는 앞뒤 공백을 제외하고 1~200자여야 하며 같은 키를 중복 입력할 수 없습니다.
        </p>
    </div>

    <fieldset class="form-stack rounded-xl border border-slate-200 p-4">
        <legend class="px-2 font-medium text-slate-700">참여 자격 (선택)</legend>
        <p class="text-sm text-slate-500">
            비워 두면 제한하지 않습니다. 두 조건을 모두 설정하면 둘 다 충족해야 합니다.
        </p>
        <div class="field-group">
            <label asp-for="MinimumAccountAgeDays" class="field-label">최소 계정 경과 기간</label>
            <input asp-for="MinimumAccountAgeDays"
                   type="number"
                   min="1"
                   max="365"
                   class="field-input" />
            <span asp-validation-for="MinimumAccountAgeDays" class="field-error"></span>
        </div>
        <div class="field-group">
            <label asp-for="MinimumCompletedReviewCount" class="field-label">최소 완료 리뷰 수</label>
            <input asp-for="MinimumCompletedReviewCount"
                   type="number"
                   min="1"
                   max="100"
                   class="field-input" />
            <span asp-validation-for="MinimumCompletedReviewCount" class="field-error"></span>
        </div>
    </fieldset>

    <div class="flex flex-wrap gap-2">
        <button type="submit" class="button-primary">드롭 예약</button>
        <a asp-page="/Games/Detail"
           asp-route-id="@Model.Game.Id"
           class="button-link">취소</a>
    </div>
</form>

@section Scripts {
    <script type="module"
            src="~/js/dist/key-distributions/new.js"
            asp-append-version="true"></script>
}
