@page "{id:long}"
@model AddKeysModel
@{
    ViewData["Title"] = "게임 키 추가";
}

<h1 class="page-title">게임 키 추가</h1>
<p class="mb-6 mt-1 text-slate-500">
    <a asp-page="/Games/Detail"
       asp-route-id="@Model.Drop.GameId"
       class="text-link">@Model.Drop.GameTitle</a>
</p>

<dl class="surface-list mb-6 max-w-2xl">
    <div class="surface-detail-row">
        <dt class="surface-detail-term">현재 재고</dt>
        <dd>총 @(Model.Drop.TotalKeys)개 중 @(Model.Drop.RemainingKeys)개 남음</dd>
    </div>
    <div class="surface-detail-row">
        <dt class="surface-detail-term">상태</dt>
        <dd>
            @if (Model.Drop.CanClaim)
            {
                <span class="badge-success">@Model.Drop.StatusText</span>
            }
            else
            {
                <span class="badge-neutral">@Model.Drop.StatusText</span>
            }
        </dd>
    </div>
</dl>

@if (Model.Drop.CanAddInventory)
{
    <form method="post" asp-route-id="@Model.Drop.Id" class="form-stack">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="field-group">
            <label asp-for="KeysText" class="field-label">추가할 게임 키</label>
            <textarea asp-for="KeysText"
                      class="field-input"
                      rows="8"
                      placeholder="한 줄에 키 하나"></textarea>
            <span asp-validation-for="KeysText" class="field-error"></span>
            <p class="text-sm text-slate-500">
                입력한 키 중 하나라도 유효하지 않거나 이미 등록된 키면 전체 추가를 취소합니다.
            </p>
        </div>

        <div class="flex flex-wrap gap-2">
            <button type="submit" class="button-primary">키 추가</button>
            <a asp-page="/KeyDrops/Detail"
               asp-route-id="@Model.Drop.Id"
               class="button-link">취소</a>
        </div>
    </form>
}
else
{
    <div class="alert-neutral">
        예정 또는 진행 중인 배포에만 키를 추가할 수 있습니다.
    </div>
    <a asp-page="/KeyDrops/Detail"
       asp-route-id="@Model.Drop.Id"
       class="button-link">배포 상세로</a>
}
