@page "{id:long}"
@model AddKeysModel
@{
    ViewData["Title"] = "게임 키 추가";
    ViewData["MainClass"] = "site-main-game-editor";
}

<section data-drop-editor="inventory">
    <nav class="ivory-breadcrumb" aria-label="현재 위치">
        <a asp-page="/Games/Detail" asp-route-id="@Model.Drop.GameId">@Model.Drop.GameTitle</a>
        <span aria-hidden="true">/</span>
        <a asp-page="/KeyDrops/Detail" asp-route-id="@Model.Drop.Id">키 배포</a>
        <span aria-hidden="true">/</span>
        <span>재고 추가</span>
    </nav>

    <header class="ivory-page-heading">
        <div>
            <p class="ivory-heading-label">ADD INVENTORY</p>
            <h1>게임 키 추가</h1>
            <p>예정 또는 진행 중인 배포에 새 게임 키 재고를 보충합니다.</p>
        </div>
    </header>

    <div class="ivory-game-editor-layout">
        <div>
            @if (Model.Drop.CanAddInventory)
            {
                <form method="post" asp-route-id="@Model.Drop.Id" class="ivory-game-editor-form">
                    <div asp-validation-summary="ModelOnly" role="alert"></div>
                    <section class="ivory-form-section" aria-labelledby="add-keys-heading">
                        <div class="ivory-form-section-heading">
                            <span>+</span>
                            <div>
                                <h2 id="add-keys-heading">추가할 키</h2>
                                <p>새 재고로 등록할 키를 한 줄에 하나씩 입력합니다.</p>
                            </div>
                        </div>
                        <div class="field-group">
                            <label asp-for="KeysText" class="field-label">추가할 게임 키</label>
                            <textarea asp-for="KeysText"
                                      class="field-input ivory-key-input"
                                      rows="12"
                                      spellcheck="false"
                                      placeholder="한 줄에 키 하나"></textarea>
                            <span asp-validation-for="KeysText" class="field-error"></span>
                            <p class="field-hint">입력한 키 중 하나라도 유효하지 않거나 이미 등록된 키면 전체 추가를 취소합니다.</p>
                        </div>
                    </section>
                    <div class="ivory-editor-actions">
                        <a asp-page="/KeyDrops/Detail" asp-route-id="@Model.Drop.Id" class="button-link">취소</a>
                        <button type="submit" class="button-primary">키 추가</button>
                    </div>
                </form>
            }
            else
            {
                <div class="ivory-unavailable-card">
                    <span aria-hidden="true">×</span>
                    <h2>지금은 키를 추가할 수 없습니다.</h2>
                    <p>예정 또는 진행 중인 배포에만 키를 추가할 수 있습니다.</p>
                    <a asp-page="/KeyDrops/Detail" asp-route-id="@Model.Drop.Id" class="button-outline">배포 상세로</a>
                </div>
            }
        </div>

        <aside class="ivory-game-editor-sidebar" aria-label="현재 배포 재고">
            <section class="ivory-side-card ivory-inventory-card">
                <p class="ivory-card-label">CURRENT INVENTORY</p>
                <h2>현재 재고</h2>
                <dl>
                    <div><dt>전체 등록</dt><dd>@Model.Drop.TotalKeys</dd></div>
                    <div><dt>남은 키</dt><dd>@Model.Drop.RemainingKeys</dd></div>
                </dl>
                @if (Model.Drop.CanClaim)
                {
                    <span class="badge-success">@Model.Drop.StatusText</span>
                }
                else
                {
                    <span class="badge-neutral">@Model.Drop.StatusText</span>
                }
            </section>

            <section class="ivory-side-card ivory-editor-note">
                <p class="ivory-card-label">ATOMIC UPDATE</p>
                <p>검증을 모두 통과한 경우에만 입력한 키 전체가 재고에 반영됩니다.</p>
            </section>
        </aside>
    </div>
</section>
