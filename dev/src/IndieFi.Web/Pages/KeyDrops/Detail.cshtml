@page "{id:long}"
@using IndieFi.Web.Application.Time
@using IndieFi.Web.Modules.KeyDistributions.Application
@using IndieFi.Web.Modules.KeyDistributions.Domain
@model DetailModel
@{
    ViewData["Title"] = "드롭 상세";
    ViewData["MainClass"] = "site-main-key-drop";
}

<nav class="ivory-breadcrumb" aria-label="현재 위치">
    <a asp-page="/Games/Detail" asp-route-id="@Model.Drop.GameId">@Model.Drop.GameTitle</a>
    <span aria-hidden="true">/</span>
    <span>키 배포</span>
</nav>

<header class="ivory-page-heading ivory-drop-heading">
    <div>
        <p class="ivory-heading-label">KEY DROP</p>
        <h1>드롭 상세</h1>
        <p>오픈 일정과 참여 조건을 확인하고 대기실을 통해 게임 키를 요청합니다.</p>
    </div>
    @if (Model.Drop.CanClaim)
    {
        <span class="badge-success">@Model.Drop.StatusText</span>
    }
    else
    {
        <span class="badge-neutral">@Model.Drop.StatusText</span>
    }
</header>

@if (Model.ClaimMessage is string claimMessage)
{
    <div class="alert-warning" role="alert">@claimMessage</div>
}
@if (Model.InventoryMessage is string inventoryMessage)
{
    <div class="alert-success" role="status">@inventoryMessage</div>
}
@if (Model.ClosureMessage is string closureMessage)
{
    <div class="alert-success" role="status">@closureMessage</div>
}
@if (Model.WaitingRoomMessage is string waitingRoomMessage)
{
    <div class="alert-warning" role="status">@waitingRoomMessage</div>
}
@if (Model.OpenNotificationMessage is string openNotificationMessage)
{
    <div class="alert-success" role="status">@openNotificationMessage</div>
}

<section class="drop-overview ivory-drop-overview" aria-labelledby="drop-overview-heading">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <p class="ivory-card-label">DROP STATUS</p>
            <h2 id="drop-overview-heading" class="section-title mt-2 mb-0">배포 현황</h2>
        </div>
        <span class="text-meta">현재 상태와 참여 조건을 확인하세요.</span>
    </div>

    <dl class="drop-metrics">
        <div class="drop-metric">
            <dt class="text-meta">오픈 시각</dt>
            <dd class="drop-metric-value">
                @KoreanStandardTime.ToLocal(Model.Drop.OpensAt).ToString("yyyy-MM-dd HH:mm") KST
            </dd>
        </div>
        <div class="drop-metric">
            <dt class="text-meta">키 재고</dt>
            <dd class="drop-metric-value" data-key-drop-inventory>총 @(Model.Drop.TotalKeys)개 중 @(Model.Drop.RemainingKeys)개 남음</dd>
        </div>
        <div class="drop-metric">
            <dt class="text-meta">참여 자격</dt>
            <dd class="drop-metric-value">
                @if (Model.Drop.MinimumAccountAgeDays is null
                    && Model.Drop.MinimumCompletedReviewCount is null)
                {
                    <span>제한 없음</span>
                }
                else
                {
                    @if (Model.Drop.MinimumAccountAgeDays is int minimumAge)
                    {
                        <span class="block">가입 후 @(minimumAge)일 이상</span>
                    }
                    @if (Model.Drop.MinimumCompletedReviewCount is int minimumReviews)
                    {
                        <span class="block">완료 리뷰 @(minimumReviews)개 이상</span>
                    }
                }
            </dd>
        </div>
    </dl>
</section>

<div class="drop-flow-grid ivory-drop-flow">
@if (Model.Drop.Status == KeyDropStatus.Scheduled)
{
    <section class="surface-card ivory-drop-card ivory-drop-notification">
        <p class="ivory-card-label">OPEN ALERT</p>
        <h2 class="subsection-title">오픈 알림</h2>
        <p class="mt-1 text-sm text-slate-600">
            알림은 늦게 도착할 수 있으며, 신청해도 게임 키 수령 기회를 보장하지 않습니다.
        </p>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <p class="mt-3 text-sm text-slate-600">로그인하면 배포 오픈 알림을 신청할 수 있습니다.</p>
        }
        else if (Model.IsOpenNotificationSubscribed)
        {
            <form method="post" asp-page-handler="UnsubscribeNotification" class="mt-3">
                <button type="submit" class="button-outline">오픈 알림 신청 취소</button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="SubscribeNotification" class="mt-3">
                <button type="submit" class="button-primary">오픈 알림 신청</button>
            </form>
        }
    </section>
}

<section class="surface-card ivory-drop-card ivory-waiting-room-card">
    <p class="ivory-card-label">WAITING ROOM</p>
    <h2 class="subsection-title">가상 대기실</h2>
    <p class="mt-1 text-sm text-slate-500">
        대기실 진입은 게임 키 예약이나 지급을 보장하지 않습니다.
    </p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div data-waiting-room-client
             data-drop-id="@Model.Drop.Id"
             data-total-keys="@Model.Drop.TotalKeys"
             data-snapshot-url="@Url.Page("/KeyDrops/Detail", "WaitingRoomSnapshot", new { id = Model.Drop.Id })"
             data-hub-url="@Url.Content("~/hubs/waiting-room")"
             data-client-state="starting">
            <p class="dynamic-status dynamic-status-loading mt-3"
               data-live-state
               aria-live="polite">최신 대기실 상태 확인 중…</p>
            <p class="mt-1 text-sm text-slate-600" data-live-position hidden></p>
            <p class="mt-1 text-sm text-slate-500" data-live-counts hidden></p>
            <p class="mt-1 text-sm font-medium text-emerald-700" data-live-admission hidden></p>
        </div>
    }
    @if (User.Identity?.IsAuthenticated != true)
    {
        <p class="mt-3 text-sm text-slate-600">로그인하면 대기실에 참여할 수 있습니다.</p>
    }
    else if (Model.WaitingRoom?.Entry is not null)
    {
        <p class="mt-3 font-medium" data-waiting-room-state>@Model.GetWaitingRoomStateText()</p>
        @if (Model.WaitingRoom.Snapshot?.Position is int position
            && Model.WaitingRoom.Snapshot.AheadCount is int aheadCount)
        {
            <p class="mt-1 text-sm text-slate-600" data-waiting-room-position>
                현재 @(position)번 · 앞에 @(aheadCount)명
            </p>
        }
        else if (Model.WaitingRoom.Entry.State == WaitingRoomEntryState.PreWaiting)
        {
            <p class="mt-1 text-sm text-slate-600">
                오픈 시 사전 대기자의 순서를 한 번 무작위로 확정합니다.
            </p>
        }
        @if (Model.WaitingRoom.Entry.State == WaitingRoomEntryState.Admitted
            && Model.GetAdmissionExpiresAt() is DateTimeOffset admissionExpiresAt)
        {
            <p class="mt-2 text-sm font-medium text-emerald-700">
                <time data-admission-expires-at="@admissionExpiresAt.ToString("O")">
                    @KoreanStandardTime.ToLocal(admissionExpiresAt).ToString("HH:mm:ss") KST
                </time>까지 키를 받아 주세요.
            </p>
            <p class="mt-1 text-sm text-slate-500">
                재접속해도 입장 가능 시간은 연장되지 않으며, 이 상태만으로 키가 예약되지는 않습니다.
            </p>
        }
        else if (Model.WaitingRoom.Entry.State == WaitingRoomEntryState.Expired)
        {
            <p class="mt-1 text-sm text-slate-600">
                입장 가능 시간이 지났습니다. 다시 참여하면 현재 대기열의 마지막 순서로 들어갑니다.
            </p>
        }
        @if (Model.WaitingRoom.Snapshot is { } waitingSnapshot)
        {
            <p class="mt-1 text-sm text-slate-500">
                대기 @(waitingSnapshot.WaitingCount)명 · 사전 대기 @(waitingSnapshot.PreWaitingCount)명 · 입장 중 @(waitingSnapshot.AdmittedCount)명
            </p>
        }
        <form method="post" asp-page-handler="Join" class="mt-3">
            @if (Model.WaitingRoom.Entry.State == WaitingRoomEntryState.Expired)
            {
                <button type="submit" class="button-primary">대기열 마지막으로 다시 참여</button>
            }
            else
            {
                <button type="submit" class="button-link">현재 상태 다시 확인</button>
            }
        </form>
    }
    else if (Model.WaitingRoom?.CanJoin == true)
    {
        <form method="post" asp-page-handler="Join" class="mt-3">
            <button type="submit" class="button-primary">대기실 입장</button>
        </form>
    }
    else if (Model.WaitingRoom?.Outcome == WaitingRoomParticipationOutcome.NotYetOpen)
    {
        <p class="mt-3 text-sm text-slate-600">오픈 30분 전부터 입장할 수 있습니다.</p>
    }
    else if (Model.WaitingRoom?.Outcome == WaitingRoomParticipationOutcome.NotEligible)
    {
        <p class="mt-3 text-sm text-slate-600">현재 참여 자격을 충족하지 못했습니다.</p>
    }
    else if (Model.WaitingRoom?.Outcome == WaitingRoomParticipationOutcome.Unavailable)
    {
        <p class="mt-3 text-sm text-slate-600">현재 대기실에 연결할 수 없습니다.</p>
    }
</section>
</div>

<section class="drop-action-panel ivory-drop-action" aria-labelledby="drop-action-heading">
    <div>
        <p class="ivory-card-label">CLAIM</p>
        <h2 id="drop-action-heading" class="text-lg font-bold">게임 키 받기</h2>
        <p class="text-meta mt-1">대기실에서 입장 가능 상태가 된 뒤 재고가 남아 있을 때 요청할 수 있습니다.</p>
    </div>
    <div>
        @if (Model.ClaimedKey is not null)
        {
            <div class="rounded-xl bg-white px-4 py-3 text-brand-deep"
                 role="alert"
                 data-claim-result="granted">
                받은 키: <strong>@Model.ClaimedKey</strong>
            </div>
        }
        else if (!Model.Drop.CanClaim)
        {
            <button type="button" class="button-primary" disabled>@Model.Drop.StatusText</button>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-page="/Login"
               asp-route-returnUrl="@Url.Page("/KeyDrops/Detail", new { id = Model.Drop.Id })"
               class="button-primary">로그인 후 참여</a>
        }
        else
        {
            <form method="post" asp-page-handler="Claim">
                @if (Model.WaitingRoom?.Entry?.State == WaitingRoomEntryState.Admitted)
                {
                    <button type="submit" class="button-primary" data-waiting-room-claim>키 받기</button>
                }
                else
                {
                    <button type="submit" class="button-primary" data-waiting-room-claim disabled>대기실 입장 후 키 받기</button>
                }
            </form>
        }
    </div>
</section>

<a asp-page="/Games/Detail"
   asp-route-id="@Model.Drop.GameId"
   class="text-link mt-6 inline-block">← 게임으로</a>

@section Scripts
{
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script type="module" src="~/js/dist/key-distributions/detail.js" asp-append-version="true"></script>
    }
}
