@page "{id:long}"
@model DetailModel
@{
    ViewData["Title"] = "드롭 상세";
}

<h1 class="h3 mb-1">드롭 상세</h1>
<p class="text-muted mb-4">
    <a asp-page="/Games/Detail" asp-route-id="@Model.Game.Id">@Model.Game.Title</a>
</p>

<dl class="row">
    <dt class="col-sm-2">오픈 시각</dt>
    <dd class="col-sm-10">@Model.Drop.OpensAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

    <dt class="col-sm-2">키 수</dt>
    <dd class="col-sm-10">키 @(Model.Drop.TotalKeys)개</dd>

    <dt class="col-sm-2">상태</dt>
    <dd class="col-sm-10">
        @if (Model.IsOpen)
        {
            <span class="badge bg-success">진행 중</span>
        }
        else
        {
            <span class="badge bg-secondary">오픈 예정</span>
        }
    </dd>
</dl>

<a asp-page="/Games/Detail"
   asp-route-id="@Model.Game.Id"
   class="btn btn-link px-0">← 게임으로</a>
