@page "{id:long}"
@model DetailModel
@{
    ViewData["Title"] = "드롭 상세";
}

<h1 class="page-title">드롭 상세</h1>
<p class="mb-6 mt-1 text-slate-500">
    <a asp-page="/Games/Detail" asp-route-id="@Model.Drop.GameId" class="text-link">@Model.Drop.GameTitle</a>
</p>

@if (Model.ClaimMessage is string claimMessage)
{
    <div class="alert-warning" role="alert">@claimMessage</div>
}
@if (Model.InventoryMessage is string inventoryMessage)
{
    <div class="alert-success" role="status">@inventoryMessage</div>
}
@if (Model.ClosureMessage is string closureMessage)
{
    <div class="alert-success" role="status">@closureMessage</div>
}

<dl class="mb-6 max-w-2xl overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="grid gap-1 border-b border-slate-200 p-4 sm:grid-cols-[10rem_1fr] sm:gap-4">
        <dt class="font-medium text-slate-700">오픈 시각</dt>
        <dd>@Model.Drop.OpensAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
    </div>
    <div class="grid gap-1 border-b border-slate-200 p-4 sm:grid-cols-[10rem_1fr] sm:gap-4">
        <dt class="font-medium text-slate-700">키 수</dt>
        <dd>총 @(Model.Drop.TotalKeys)개 중 @(Model.Drop.RemainingKeys)개 남음</dd>
    </div>
    <div class="grid gap-1 p-4 sm:grid-cols-[10rem_1fr] sm:gap-4">
        <dt class="font-medium text-slate-700">상태</dt>
        <dd>
            @if (Model.Drop.CanClaim)
            {
                <span class="badge-success">@Model.Drop.StatusText</span>
            }
            else
            {
                <span class="badge-neutral">@Model.Drop.StatusText</span>
            }
        </dd>
    </div>
</dl>

@if (Model.ClaimedKey is not null)
{
    <div class="alert-success" role="alert">
        받은 키: <strong>@Model.ClaimedKey</strong>
    </div>
}
else if (!Model.Drop.CanClaim)
{
    <button type="button" class="button-primary" disabled>@Model.Drop.StatusText</button>
}
else if (User.Identity?.IsAuthenticated != true)
{
    <p>
        키를 받으려면 <a asp-page="/Login"
                       asp-route-returnUrl="@Url.Page("/KeyDrops/Detail", new { id = Model.Drop.Id })"
                       class="text-link">로그인</a>해 주세요.
    </p>
}
else
{
    <form method="post" asp-page-handler="Claim">
        <button type="submit" class="button-primary">키 받기</button>
    </form>
}

<a asp-page="/Games/Detail"
   asp-route-id="@Model.Drop.GameId"
   class="text-link mt-6 inline-block">← 게임으로</a>
