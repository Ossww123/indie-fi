@page "{id:long}"
@model DetailModel
@{
    ViewData["Title"] = "드롭 상세";
}

<h1 class="h3 mb-1">드롭 상세</h1>
<p class="text-muted mb-4">
    <a asp-page="/Games/Detail" asp-route-id="@Model.Game.Id">@Model.Game.Title</a>
</p>

@if (Model.ClaimMessage is string claimMessage)
{
    <div class="alert alert-warning" role="alert">@claimMessage</div>
}

<dl class="row">
    <dt class="col-sm-2">오픈 시각</dt>
    <dd class="col-sm-10">@Model.Drop.OpensAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

    <dt class="col-sm-2">키 수</dt>
    <dd class="col-sm-10">총 @(Model.Drop.TotalKeys)개 중 @(Model.RemainingKeys)개 남음</dd>

    <dt class="col-sm-2">상태</dt>
    <dd class="col-sm-10">
        @if (Model.IsOpen)
        {
            <span class="badge bg-success">진행 중</span>
        }
        else
        {
            <span class="badge bg-secondary">오픈 예정</span>
        }
    </dd>
</dl>

@if (Model.ClaimedKey is not null)
{
    <div class="alert alert-success" role="alert">
        받은 키: <strong>@Model.ClaimedKey</strong>
    </div>
}
else if (User.Identity?.IsAuthenticated != true)
{
    <p>
        키를 받으려면 <a asp-page="/Login">로그인</a>해 주세요.
    </p>
}
else if (!Model.IsOpen)
{
    <button type="button" class="btn btn-primary" disabled>오픈 예정</button>
}
else
{
    <form method="post" asp-page-handler="Claim">
        <button type="submit" class="btn btn-primary">키 받기</button>
    </form>
}

<a asp-page="/Games/Detail"
   asp-route-id="@Model.Game.Id"
   class="btn btn-link px-0">← 게임으로</a>
