@page "{id:long}"
@model CloseModel
@{
    ViewData["Title"] = "배포 조기 마감";
}

<section class="editor-shell" data-drop-editor="close">
<header class="page-heading">
    <div class="page-heading-copy">
        <p class="auth-eyebrow">CLOSE DROP</p>
        <h1 class="page-title mt-2">배포 조기 마감</h1>
        <p class="page-description">
            <a asp-page="/Games/Detail"
               asp-route-id="@Model.Drop.GameId"
               class="text-link">@Model.Drop.GameTitle</a>
        </p>
    </div>
</header>

<dl class="surface-list mb-6 max-w-2xl">
    <div class="surface-detail-row">
        <dt class="surface-detail-term">현재 재고</dt>
        <dd>총 @(Model.Drop.TotalKeys)개 중 @(Model.Drop.RemainingKeys)개 남음</dd>
    </div>
    <div class="surface-detail-row">
        <dt class="surface-detail-term">상태</dt>
        <dd><span class="badge-neutral">@Model.Drop.StatusText</span></dd>
    </div>
</dl>

@if (Model.Drop.CanCloseEarly)
{
    <div class="alert-warning">
        마감하면 새 키를 받을 수 없으며 현재는 다시 열 수 없습니다.
        이미 발급된 키는 그대로 유지됩니다.
    </div>
    <form method="post" asp-route-id="@Model.Drop.Id" class="form-stack">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <div class="button-group">
            <button type="submit" class="button-danger">조기 마감 확인</button>
            <a asp-page="/KeyDrops/Detail"
               asp-route-id="@Model.Drop.Id"
               class="button-link">취소</a>
        </div>
    </form>
}
else
{
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="alert-neutral">
        예정 또는 진행 중인 배포만 조기 마감할 수 있습니다.
    </div>
    <a asp-page="/KeyDrops/Detail"
       asp-route-id="@Model.Drop.Id"
       class="button-link">배포 상세로</a>
}
</section>
