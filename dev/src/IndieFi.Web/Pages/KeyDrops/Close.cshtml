@page "{id:long}"
@model CloseModel
@{
    ViewData["Title"] = "배포 조기 마감";
    ViewData["MainClass"] = "site-main-confirm";
}

<section data-drop-editor="close">
    <nav class="ivory-breadcrumb" aria-label="현재 위치">
        <a asp-page="/Games/Detail" asp-route-id="@Model.Drop.GameId">@Model.Drop.GameTitle</a>
        <span aria-hidden="true">/</span>
        <a asp-page="/KeyDrops/Detail" asp-route-id="@Model.Drop.Id">키 배포</a>
        <span aria-hidden="true">/</span>
        <span>조기 마감</span>
    </nav>

    <header class="ivory-page-heading">
        <div>
            <p class="ivory-heading-label">CLOSE DROP</p>
            <h1>배포 조기 마감</h1>
            <p>현재 배포를 예정된 흐름보다 먼저 종료합니다.</p>
        </div>
    </header>

    <article class="ivory-confirm-card">
        <div class="ivory-confirm-symbol" aria-hidden="true">!</div>
        <p class="ivory-card-label">IRREVERSIBLE ACTION</p>
        <h2>@Model.Drop.GameTitle 키 배포를 마감할까요?</h2>

        <dl class="ivory-confirm-metrics">
            <div>
                <dt>배포 상태</dt>
                <dd><span class="badge-neutral">@Model.Drop.StatusText</span></dd>
            </div>
            <div>
                <dt>전체 키</dt>
                <dd>@Model.Drop.TotalKeys 개</dd>
            </div>
            <div>
                <dt>남은 키</dt>
                <dd>@Model.Drop.RemainingKeys 개</dd>
            </div>
        </dl>

        @if (Model.Drop.CanCloseEarly)
        {
            <div class="ivory-confirm-warning">
                <strong>마감 전에 확인하세요.</strong>
                <ul>
                    <li>마감 뒤에는 새 키를 받을 수 없습니다.</li>
                    <li>현재는 마감한 배포를 다시 열 수 없습니다.</li>
                    <li>이미 발급된 게임 키는 그대로 유지됩니다.</li>
                </ul>
            </div>
            <form method="post" asp-route-id="@Model.Drop.Id" class="ivory-confirm-actions">
                <div asp-validation-summary="ModelOnly" role="alert"></div>
                <a asp-page="/KeyDrops/Detail" asp-route-id="@Model.Drop.Id" class="button-outline">취소하고 돌아가기</a>
                <button type="submit" class="button-danger">조기 마감 확인</button>
            </form>
        }
        else
        {
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="ivory-confirm-unavailable">예정 또는 진행 중인 배포만 조기 마감할 수 있습니다.</div>
            <div class="ivory-confirm-actions">
                <a asp-page="/KeyDrops/Detail" asp-route-id="@Model.Drop.Id" class="button-outline">배포 상세로</a>
            </div>
        }
    </article>
</section>
