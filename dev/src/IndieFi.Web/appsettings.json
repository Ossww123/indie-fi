{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "Enabled": false
    }
  },
  "Media": {
    "UploadRateLimit": {
      "KeyPrefix": "indiefi:media-upload:v1"
    },
    "ObjectStorage": {
      "Enabled": false,
      "ServiceUrl": "",
      "Region": "auto",
      "BucketName": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "OperationTimeout": "00:00:10",
      "ForcePathStyle": false
    }
  },
  "Messaging": {
    "RabbitMq": {
      "Enabled": false,
      "Host": "",
      "Port": 5672,
      "VirtualHost": "/",
      "Username": "",
      "Password": "",
      "EndpointPrefix": "indiefi"
    }
  },
  "WaitingRoom": {
    "Policy": {
      "OpensBefore": "00:30:00",
      "ReconnectGrace": "00:05:00",
      "AdmissionLifetime": "00:02:00",
      "ConcurrentAdmissionLimit": 10,
      "ActiveStateTtl": "7.00:00:00",
      "TerminalStateTtl": "01:00:00"
    },
    "Redis": {
      "Enabled": false,
      "ConnectionString": "",
      "KeyPrefix": "indiefi:waiting-room:v1",
      "ConnectTimeout": "00:00:02"
    }
  }
}
