{
  "DetailedErrors": true,
  "Media": {
    "ObjectStorage": {
      "Enabled": true,
      "ServiceUrl": "http://127.0.0.1:9000",
      "Region": "us-east-1",
      "BucketName": "indiefi-media-dev",
      "AccessKeyId": "indiefi-media",
      "ForcePathStyle": true
    }
  },
  "WaitingRoom": {
    "Redis": {
      "Enabled": true,
      "ConnectionString": "127.0.0.1:6379,abortConnect=false",
      "KeyPrefix": "indiefi:waiting-room:v1",
      "ConnectTimeout": "00:00:02"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
