# Copy this file to dev/.env and fill in the value. dev/.env is not committed.
#
#   docker compose  - creates the local database with this password
#   loadtest.bat    - builds the seeder's connection string from it
#
# The web app does not read this file. Its connection string lives in user secrets:
#   dotnet user-secrets set "ConnectionStrings:Database" "Host=localhost;Port=5432;Database=indiefi;Username=indiefi_app;Password=<app-role value>" --project dev/src/IndieFi.Web
# Local waiting-room Redis also needs explicit app configuration:
#   dotnet user-secrets set "WaitingRoom:Redis:Enabled" "true" --project dev/src/IndieFi.Web
#   dotnet user-secrets set "WaitingRoom:Redis:ConnectionString" "localhost:6379" --project dev/src/IndieFi.Web
# Local RabbitMQ uses the password below for its container. Configure the same
# non-guest credentials in both the Web and Worker user-secrets stores:
#   dotnet user-secrets set "Messaging:RabbitMq:Enabled" "true" --project dev/src/IndieFi.Web
#   dotnet user-secrets set "Messaging:RabbitMq:Host" "localhost" --project dev/src/IndieFi.Web
#   dotnet user-secrets set "Messaging:RabbitMq:Username" "indiefi" --project dev/src/IndieFi.Web
#   dotnet user-secrets set "Messaging:RabbitMq:Password" "<RABBITMQ_PASSWORD value>" --project dev/src/IndieFi.Web
#   dotnet user-secrets set "ConnectionStrings:Database" "Host=localhost;Port=5432;Database=indiefi;Username=indiefi_app;Password=<app-role value>" --project dev/src/IndieFi.Worker
#   dotnet user-secrets set "Messaging:RabbitMq:Password" "<RABBITMQ_PASSWORD value>" --project dev/src/IndieFi.Worker
# Notification email runs only in IndieFi.Worker. Development defaults target the
# local Mailpit container; production must set NotificationEmail SMTP values and
# provide the same AccountProtection key configuration used by IndieFi.Web so the
# Worker can decrypt account email addresses.
#   dotnet user-secrets set "WaitingRoom:Redis:Enabled" "true" --project dev/src/IndieFi.Worker
#   dotnet user-secrets set "WaitingRoom:Redis:ConnectionString" "localhost:6379" --project dev/src/IndieFi.Worker
#
# Changing this after the container exists will not work: POSTGRES_PASSWORD only
# applies when the data directory is first created. Recreate it with
# `docker compose down -v` if you really need a new password.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
